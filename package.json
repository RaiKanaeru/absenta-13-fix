  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently \"npm run start:modern\" \"npm run dev\"",
    "dev:setup": "node setup-database-modern.js && concurrently \"npm run start:modern\" \"npm run dev\"",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node server.js",
    "start:modern": "node server_modern.js",
    "start:optimized": "node server_optimized.js",
    "server": "node server.js",
    "server:modern": "node server_modern.js",
    "server:optimized": "node server_optimized.js",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:security": "jest tests/security",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:security && npm run test:e2e",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:performance": "artillery run tests/performance/load-test.yml",
    "test:ci": "npm run test:unit && npm run test:integration && npm run test:security",
    "test:debug": "jest --detectOpenHandles --forceExit",
    "test:verbose": "jest --verbose",
    "test:update-snapshots": "jest --updateSnapshot",
    "test:clear-cache": "jest --clearCache",
    "test:report": "jest --coverage --coverageReporters=html",
    "test:performance:report": "artillery run tests/performance/load-test.yml --output tests/performance/report.json",
    "test:performance:html": "artillery run tests/performance/load-test.yml --output tests/performance/report.json && artillery report tests/performance/report.json --output tests/performance/report.html",
    "test:setup": "node tests/setup.js",
    "test:clean": "rimraf coverage tests/performance/report.json tests/performance/report.html",
    "test:lint": "eslint tests/ --ext .js,.ts",
    "test:lint:fix": "eslint tests/ --ext .js,.ts --fix",
    "test:format": "prettier --write tests/",
    "test:format:check": "prettier --check tests/",
    "test:type-check": "tsc --noEmit",
    "test:validate": "npm run test:lint && npm run test:format:check && npm run test:type-check",
    "test:full": "npm run test:validate && npm run test:all && npm run test:performance",
    "test:quick": "npm run test:unit",
    "test:smoke": "npm run test:unit && npm run test:integration",
    "test:regression": "npm run test:all",
    "test:acceptance": "npm run test:e2e",
    "test:load": "npm run test:performance",
    "test:security:scan": "npm run test:security",
    "test:quality": "npm run test:coverage && npm run test:performance",
    "test:ci:full": "npm run test:validate && npm run test:ci && npm run test:performance",
    "test:ci:quick": "npm run test:unit && npm run test:integration",
    "test:ci:security": "npm run test:security",
    "test:ci:performance": "npm run test:performance",
    "test:ci:coverage": "npm run test:coverage",
    "test:ci:report": "npm run test:report",
    "test:ci:clean": "npm run test:clean",
    "test:ci:setup": "npm run test:setup",
    "test:ci:validate": "npm run test:validate",
    "test:ci:lint": "npm run test:lint",
    "test:ci:format": "npm run test:format:check",
    "test:ci:type": "npm run test:type-check",
    "setup-db": "node setup-database-modern.js",
    "optimize-db": "node run-database-optimization.js",
    "test-performance": "node test-performance.js"
