## 📊 Permission Analytics

### Permission Statistics
```javascript
const permissionAnalytics = {
  // 1. Get permission statistics
  getPermissionStats: async (startDate, endDate) => {
    const [stats] = await db.execute(`
      SELECT 
        COUNT(*) as total_permissions,
        SUM(CASE WHEN status_izin = 'pending' THEN 1 ELSE 0 END) as pending_permissions,
        SUM(CASE WHEN status_izin = 'disetujui' THEN 1 ELSE 0 END) as approved_permissions,
        SUM(CASE WHEN status_izin = 'ditolak' THEN 1 ELSE 0 END) as rejected_permissions,
        (SUM(CASE WHEN status_izin = 'disetujui' THEN 1 ELSE 0 END) / COUNT(*)) * 100 as approval_rate
      FROM pengajuan_izin_siswa 
      WHERE tanggal_pengajuan BETWEEN ? AND ?
    `, [startDate, endDate]);
    
    return stats[0];
  },
  
  // 2. Get permission trends by type
  getPermissionTrendsByType: async (days = 30) => {
    const [trends] = await db.execute(`
      SELECT 
        jenis_izin,
        COUNT(*) as total_permissions,
        SUM(CASE WHEN status_izin = 'disetujui' THEN 1 ELSE 0 END) as approved,
        SUM(CASE WHEN status_izin = 'ditolak' THEN 1 ELSE 0 END) as rejected
      FROM pengajuan_izin_siswa 
      WHERE tanggal_pengajuan >= DATE_SUB(CURDATE(), INTERVAL ? DAY)
      GROUP BY jenis_izin
      ORDER BY total_permissions DESC
    `, [days]);
    
    return trends;
  }
};
```

## 🚨 Error Handling for Permissions

### Permission Error Handling
```javascript
const permissionErrorHandling = {
  // 1. Validate permission data
  validatePermissionData: (data) => {
    const errors = [];
    
    if (!data.siswaId) {
      errors.push('Student ID is required');
    }
    
    if (!data.jadwalId) {
      errors.push('Schedule ID is required');
    }
    
    if (!data.tanggalIzin) {
      errors.push('Permission date is required');
    }
    
    if (!data.alasanIzin || data.alasanIzin.trim().length < 10) {
      errors.push('Reason must be at least 10 characters long');
    }
    
    if (data.tanggalMulai && data.tanggalSelesai) {
      const startDate = new Date(data.tanggalMulai);
      const endDate = new Date(data.tanggalSelesai);
      
      if (startDate > endDate) {
        errors.push('Start date cannot be after end date');
      }
    }
    
    return errors;
  },
  
  // 2. Check permission eligibility
  checkPermissionEligibility: async (siswaId, jadwalId, tanggalIzin) => {
    try {
      // Check if permission already exists for the same date and schedule
      const [existing] = await db.execute(
        'SELECT id_izin FROM pengajuan_izin_siswa WHERE siswa_id = ? AND jadwal_id = ? AND tanggal_izin = ?',
        [siswaId, jadwalId, tanggalIzin]
      );
      
      if (existing.length > 0) {
        return {
          eligible: false,
          reason: 'Permission already exists for this date and schedule'
        };
      }
      
      // Check if date is not in the past
      const permissionDate = new Date(tanggalIzin);
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      
      if (permissionDate < today) {
        return {
          eligible: false,
          reason: 'Cannot request permission for past dates'
        };
      }
      
      // Check if date is not too far in the future (e.g., 30 days)
      const maxDate = new Date();
      maxDate.setDate(maxDate.getDate() + 30);
      
      if (permissionDate > maxDate) {
        return {
          eligible: false,
          reason: 'Cannot request permission more than 30 days in advance'
        };
      }
      
      return { eligible: true };
      
    } catch (error) {
      console.error('Error checking permission eligibility:', error);
      return {
        eligible: false,
        reason: 'Error checking eligibility'
      };
    }
  }
};
