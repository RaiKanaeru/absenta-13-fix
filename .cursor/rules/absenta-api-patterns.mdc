## 🔐 Authentication Patterns

### JWT Token Implementation
```javascript
// Token Generation
const token = jwt.sign(
  { 
    id: user.id, 
    username: user.username, 
    role: user.role 
  },
  JWT_SECRET,
  { expiresIn: '24h' }
);

// Token Verification Middleware
const authenticateToken = (req, res, next) => {
  const authHeader = req.headers['authorization'];
  const token = authHeader && authHeader.split(' ')[1];
  
  if (!token) {
    return res.status(401).json({ error: 'Access token required' });
  }
  
  jwt.verify(token, JWT_SECRET, (err, user) => {
    if (err) return res.status(403).json({ error: 'Invalid token' });
    req.user = user;
    next();
  });
};
```

### Role-Based Access Control
```javascript
// Admin Only Access
const requireAdmin = (req, res, next) => {
  if (req.user.role !== 'admin') {
    return res.status(403).json({ error: 'Admin access required' });
  }
  next();
};

// Teacher or Admin Access
const requireTeacherOrAdmin = (req, res, next) => {
  if (!['admin', 'guru'].includes(req.user.role)) {
    return res.status(403).json({ error: 'Teacher or admin access required' });
  }
  next();
};
```

## 📊 Database Query Patterns

### Repository Pattern Implementation
```javascript
// User Repository Example
class UserRepository {
  async findByUsername(username) {
    const [rows] = await db.execute(
      'SELECT * FROM pengguna WHERE username = ?',
      [username]
    );
    return rows[0];
  }
  
  async createUser(userData) {
    const { username, password, role, status } = userData;
    const hashedPassword = await bcrypt.hash(password, saltRounds);
    
    const [result] = await db.execute(
      'INSERT INTO pengguna (username, password, role, status) VALUES (?, ?, ?, ?)',
      [username, hashedPassword, role, status]
    );
    
    return result.insertId;
  }
}
```

### Transaction Handling
```javascript
// Database Transaction Example
const connection = await db.getConnection();
try {
  await connection.beginTransaction();
  
  // Multiple operations
  await connection.execute('INSERT INTO table1 ...');
  await connection.execute('INSERT INTO table2 ...');
  
  await connection.commit();
} catch (error) {
  await connection.rollback();
  throw error;
} finally {
  connection.release();
}
```

## 🛡️ Error Handling Patterns

### Centralized Error Handler
```javascript
// Global Error Handler
app.use((error, req, res, next) => {
  console.error('Error:', error);
  
  if (error.type === 'entity.too.large') {
    return res.status(413).json({
      error: 'Payload terlalu besar',
      code: 'PAYLOAD_TOO_LARGE'
    });
  }
  
  res.status(500).json({
    error: 'Internal server error',
    message: 'Terjadi kesalahan pada server'
  });
});
```

### Validation Error Handling
```javascript
// Input Validation
const validateInput = (req, res, next) => {
  const { username, password } = req.body;
  
  if (!username || !password) {
    return res.status(400).json({
      error: 'Validation failed',
      message: 'Username dan password diperlukan'
    });
  }
  
  next();
};
```

## 📈 Performance Optimization Patterns

### Database Query Optimization
```javascript
// Indexed Queries
const getSiswaWithPagination = async (page = 1, limit = 10) => {
  const offset = (page - 1) * limit;
  
  const [rows] = await db.execute(`
    SELECT s.*, p.username, p.status 
    FROM siswa_perwakilan s
    JOIN pengguna p ON s.user_id = p.id
    WHERE p.role = 'siswa'
    ORDER BY s.nama_siswa
    LIMIT ? OFFSET ?
  `, [limit, offset]);
  
  return rows;
};
```

### Caching Implementation
```javascript
// Redis Caching
const cacheMiddleware = (duration = 300) => {
  return async (req, res, next) => {
    const key = `cache:${req.originalUrl}`;
    const cached = await redis.get(key);
    
    if (cached) {
      return res.json(JSON.parse(cached));
    }
    
    res.sendResponse = res.json;
    res.json = (body) => {
      redis.setex(key, duration, JSON.stringify(body));
      res.sendResponse(body);
    };
    
    next();
  };
};
```

## 🔄 API Versioning Patterns

### URL Versioning
```javascript
// Version 1 API
app.use('/api/v1/admin', adminRouter);
app.use('/api/v1/attendance', attendanceRouter);

// Version 2 API (Future)
app.use('/api/v2/admin', adminV2Router);
```

### Header Versioning
```javascript
// API Version Detection
const apiVersion = (req, res, next) => {
  const version = req.headers['api-version'] || 'v1';
  req.apiVersion = version;
  next();
};
```

## 📝 Logging Patterns

### Request Logging
```javascript
// Request Logger Middleware
const requestLogger = (req, res, next) => {
  const start = Date.now();
  
  res.on('finish', () => {
    const duration = Date.now() - start;
    console.log(`${req.method} ${req.url} - ${res.statusCode} - ${duration}ms`);
  });
  
  next();
};
```

### Error Logging
```javascript
// Error Logger
const logError = (error, req) => {
  console.error('API Error:', {
    message: error.message,
    stack: error.stack,
    url: req.url,
    method: req.method,
    timestamp: new Date().toISOString()
  });
};
```

## 🧪 Testing Patterns

### API Testing Structure
```javascript
// Test Setup
describe('Authentication API', () => {
  beforeEach(async () => {
    // Setup test database
    await setupTestData();
  });
  
  afterEach(async () => {
    // Cleanup test data
    await cleanupTestData();
  });
  
  it('should authenticate valid user', async () => {
