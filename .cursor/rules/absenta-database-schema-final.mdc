## 🚀 Database Optimization (UPDATED)

### Query Optimization
```sql
-- Example optimized queries with FIXED table references
SELECT 
  j.*,
  m.nama_mapel,
  k.nama_kelas,
  g.nama as nama_guru
FROM jadwal j
JOIN mapel m ON j.mapel_id = m.id_mapel
JOIN kelas k ON j.kelas_id = k.id_kelas
JOIN guru g ON j.guru_id = g.id_guru
WHERE j.status = 'aktif'
  AND j.hari = 'Senin'
  AND j.jam_ke = 1;

-- Multi-teacher query
SELECT 
  j.*,
  m.nama_mapel,
  k.nama_kelas,
  g.nama as nama_guru_utama,
  jgt.role as peran_guru_tambahan
FROM jadwal j
JOIN mapel m ON j.mapel_id = m.id_mapel
JOIN kelas k ON j.kelas_id = k.id_kelas
JOIN guru g ON j.guru_id = g.id_guru
LEFT JOIN jadwal_guru_tambahan jgt ON j.id_jadwal = jgt.jadwal_id
WHERE j.status = 'aktif';

-- FIXED: Student attendance history query
SELECT 
  a.*,
  s.nama as nama_siswa,
  s.nis,
  j.hari,
  j.jam_ke,
  j.jam_mulai,
  j.jam_selesai,
  m.nama_mapel,
  g.nama as nama_guru
FROM absensi_siswa a
JOIN siswa s ON a.siswa_id = s.id_siswa  -- FIXED: menggunakan siswa, bukan siswa_perwakilan
JOIN jadwal j ON a.jadwal_id = j.id_jadwal
JOIN mapel m ON j.mapel_id = m.id_mapel
JOIN guru g ON j.guru_id = g.id_guru
WHERE a.tanggal BETWEEN ? AND ?
ORDER BY a.tanggal DESC, j.jam_ke ASC;
```

