# Absenta Performance Optimization Patterns

## 🚀 Backend Performance Optimization

### Database Query Optimization
```javascript
// Optimized database queries
const optimizedQueries = {
  // Use indexes for frequently queried columns
  getUserWithRole: async (username, role) => {
    const [rows] = await db.execute(`
      SELECT p.*, g.nama_guru, s.nama_siswa
      FROM pengguna p
      LEFT JOIN guru g ON p.id = g.user_id AND p.role = 'guru'
      LEFT JOIN siswa_perwakilan s ON p.id = s.user_id AND p.role = 'siswa'
      WHERE p.username = ? AND p.role = ?
      LIMIT 1
    `, [username, role]);
    
    return rows[0];
  },
  
  // Pagination with proper indexing
  getSiswaWithPagination: async (page = 1, limit = 10, search = '') => {
    const offset = (page - 1) * limit;
    
    const whereClause = search ? 
      'WHERE s.nama_siswa LIKE ? OR s.nis LIKE ?' : '';
    
    const searchParams = search ? [`%${search}%`, `%${search}%`] : [];
    
    const [rows] = await db.execute(`
      SELECT s.*, p.username, p.status, k.nama_kelas
      FROM siswa_perwakilan s
      JOIN pengguna p ON s.user_id = p.id
      JOIN kelas k ON s.kelas_id = k.id
      ${whereClause}
      ORDER BY s.nama_siswa
      LIMIT ? OFFSET ?
    `, [...searchParams, limit, offset]);
    
    return rows;
  },
  
  // Batch operations for better performance
  batchInsertAttendance: async (attendanceData) => {
    const connection = await db.getConnection();
    
    try {
      await connection.beginTransaction();
      
      const values = attendanceData.map(data => [
        data.jadwal_id,
        data.guru_id,
        data.tanggal,
        data.status,
        data.keterangan
      ]);
      
      await connection.execute(
        'INSERT INTO absensi_guru (jadwal_id, guru_id, tanggal, status, keterangan) VALUES ?',
        [values]
      );
      
      await connection.commit();
    } catch (error) {
      await connection.rollback();
      throw error;
    } finally {
      connection.release();
    }
  }
};
```

### Connection Pooling
```javascript
// Optimized database connection pool
const dbConfig = {
  host: process.env.DB_HOST,
  user: process.env.DB_USER,
  password: process.env.DB_PASSWORD,
  database: process.env.DB_NAME,
  waitForConnections: true,
  connectionLimit: 20, // Increased for better performance
  queueLimit: 0,
  acquireTimeout: 60000,
  timeout: 60000,
  reconnect: true,
  charset: 'utf8mb4',
  // Performance optimizations
  multipleStatements: false,
  supportBigNumbers: true,
  bigNumberStrings: true,
  dateStrings: false,
  debug: false,
  trace: false
};

const pool = mysql.createPool(dbConfig);

// Connection health monitoring
const monitorConnectionHealth = async () => {
  try {
    const connection = await pool.getConnection();
    await connection.ping();
    connection.release();
    return true;
  } catch (error) {
    console.error('Database connection health check failed:', error);
    return false;
  }
};
```

### Caching Implementation
```javascript
// Redis caching for performance
const redis = require('redis');
const client = redis.createClient(process.env.REDIS_URL);

const cacheMiddleware = (duration = 300) => {
  return async (req, res, next) => {
    const key = `cache:${req.originalUrl}`;
    
    try {
      const cached = await client.get(key);
      if (cached) {
        return res.json(JSON.parse(cached));
      }
    } catch (error) {
      console.error('Cache error:', error);
    }
    
    const originalSend = res.json;
    res.json = (body) => {
      client.setex(key, duration, JSON.stringify(body));
      originalSend.call(res, body);
    };
    
    next();
  };
};

// Cache invalidation
const invalidateCache = async (pattern) => {
  try {
    const keys = await client.keys(pattern);
    if (keys.length > 0) {
      await client.del(keys);
    }
  } catch (error) {
    console.error('Cache invalidation error:', error);
  }
};
```

