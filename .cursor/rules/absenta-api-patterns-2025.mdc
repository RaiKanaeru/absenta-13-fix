## 🔐 Authentication Patterns (UPDATED)

### Login Endpoint - UPDATED Pattern
```javascript
// POST /api/login - Support for new 'SISWA' role
app.post('/api/login', async (req, res) => {
  const { username, password } = req.body;
  
  // 1. Get user with role check
  const [users] = await db.execute(
    'SELECT * FROM users WHERE username = ? AND status = "aktif"',
    [username]
  );
  
  if (users.length === 0) {
    return res.status(401).json({ error: 'Invalid credentials' });
  }
  
  const user = users[0];
  
  // 2. Verify password
  const validPassword = await bcrypt.compare(password, user.password);
  if (!validPassword) {
    return res.status(401).json({ error: 'Invalid credentials' });
  }
  
  // 3. Handle SISWA role (NEW)
  if (user.role === 'SISWA' || user.role === 'siswa' || user.role === 'perwakilan') {
    const [siswaData] = await db.execute(
      `SELECT s.*, k.nama_kelas 
       FROM siswa s 
       JOIN kelas k ON s.kelas_id = k.id_kelas 
       WHERE s.user_id = ?`,
      [user.id]
    );
    
    if (siswaData.length > 0) {
      additionalData = {
        siswa_id: siswaData[0].id_siswa,
        nis: siswaData[0].nis,
        kelas: siswaData[0].nama_kelas,
        kelas_id: siswaData[0].kelas_id
      };
    }
  }
  
  // 4. Generate JWT token
  const tokenPayload = {
    id: user.id,
    username: user.username,
    role: user.role === 'perwakilan' ? 'siswa' : user.role.toLowerCase(),
    ...additionalData
  };
  
  const token = jwt.sign(tokenPayload, process.env.JWT_SECRET);
  
  res.json({ success: true, data: { token, ...tokenPayload } });
});
```

## 👨‍🎓 Student Management Endpoints (UPDATED)

### POST /api/admin/siswa - Create Student (NEW PATTERN)
```javascript
// ✅ CORRECT: Auto-create user account in transaction
app.post('/api/admin/siswa', authenticateToken, requireRole(['admin']), async (req, res) => {
  let connection;
  
  try {
    const { nis, nama, kelas_id, username, password, email } = req.body;
    
    // Validation
    if (!nis || !nama || !kelas_id || !username || !password) {
      return res.status(400).json({ error: 'Required fields missing' });
    }
    
    // Hash password
    const hashedPassword = await bcrypt.hash(password, 10);
    
    // Get connection for transaction
    connection = await db.getConnection();
    await connection.beginTransaction();
    
    // 1. Create user account first
    const [userResult] = await connection.execute(
      'INSERT INTO users (username, password, role, nama, email, status, created_at) VALUES (?, ?, "SISWA", ?, ?, "aktif", NOW())',
      [username, hashedPassword, nama, email || null]
    );
    
    const userId = userResult.insertId;
    
    // 2. Create siswa record with user_id reference
    await connection.execute(
      `INSERT INTO siswa (nis, nama, kelas_id, user_id, status, created_at) 
       VALUES (?, ?, ?, ?, "aktif", NOW())`,
      [nis, nama, kelas_id, userId]
    );
    
    await connection.commit();
    
    res.json({ 
      success: true, 
      data: {
        user_id: userId,
        username: username,
        default_password: password
      }
    });
    
  } catch (error) {
    if (connection) await connection.rollback();
    console.error('Create siswa error:', error);
    
    if (error.code === 'ER_DUP_ENTRY') {
      res.status(400).json({ error: 'NIS or username already exists' });
    } else {
      res.status(500).json({ error: 'Failed to create student' });
    }
  } finally {
    if (connection) connection.release();
  }
});
```

### PUT /api/admin/students/:id - Update Student (NEW PATTERN)
```javascript
// ✅ CORRECT: Atomically update both users and siswa tables
app.put('/api/admin/students/:id', authenticateToken, requireRole(['admin']), async (req, res) => {
  let connection;
  
  try {
    const { id } = req.params;
    const { nama, username, password, nis, kelas_id, email, status } = req.body;
    
    // Validation
    if (!nama || !username || !nis || !kelas_id) {
      return res.status(400).json({ error: 'Required fields missing' });
    }
    
    // Get connection for transaction
    connection = await db.getConnection();
    await connection.beginTransaction();
    
    // Check if user exists and is SISWA role
    const [currentUser] = await connection.execute(
      'SELECT id, role FROM users WHERE id = ?',
      [id]
    );
    
    if (currentUser.length === 0) {
      await connection.rollback();
      return res.status(404).json({ error: 'User not found' });
    }
    
    if (currentUser[0].role !== 'SISWA') {
      await connection.rollback();
      return res.status(400).json({ error: 'Not a student account' });
    }
    
    // Update user account
    if (password) {
      const hashedPassword = await bcrypt.hash(password, 10);
      await connection.execute(
        'UPDATE users SET username = ?, password = ?, nama = ?, email = ?, status = ?, updated_at = NOW() WHERE id = ?',
        [username, hashedPassword, nama, email || null, status || 'aktif', id]
      );
    } else {
      await connection.execute(
        'UPDATE users SET username = ?, nama = ?, email = ?, status = ?, updated_at = NOW() WHERE id = ?',
        [username, nama, email || null, status || 'aktif', id]
      );
    }
    
    // Update siswa data
    await connection.execute(
      `UPDATE siswa 
       SET nis = ?, nama = ?, kelas_id = ?, updated_at = NOW() 
       WHERE user_id = ?`,
      [nis, nama, kelas_id, id]
    );
    
    await connection.commit();
    
    res.json({ 
      success: true,
      message: 'Student updated successfully'
    });
    
  } catch (error) {
    if (connection) await connection.rollback();
    console.error('Update student error:', error);
    res.status(500).json({ error: 'Failed to update student' });
  } finally {
    if (connection) connection.release();
  }
});
```

### DELETE /api/admin/students/:id - Delete Student (SMART DELETE)
```javascript
// ✅ CORRECT: Smart delete - deactivate if has history, else hard delete
app.delete('/api/admin/students/:id', authenticateToken, requireRole(['admin']), async (req, res) => {
  let connection;
  
  try {
    const { id } = req.params;
    
    // Get connection for transaction
    connection = await db.getConnection();
    await connection.beginTransaction();
    
    // Check if user exists and is SISWA role
    const [userResult] = await connection.execute(
      'SELECT id, username, role FROM users WHERE id = ?',
      [id]
    );
    
    if (userResult.length === 0) {
      await connection.rollback();
      return res.status(404).json({ error: 'User not found' });
    }
    
    if (userResult[0].role !== 'SISWA') {
      await connection.rollback();
      return res.status(400).json({ error: 'Not a student account' });
    }
    
    // Check if siswa has attendance records
    const [attendanceRecords] = await connection.execute(
      'SELECT COUNT(*) as count FROM absensi_siswa WHERE siswa_id IN (SELECT id_siswa FROM siswa WHERE user_id = ?)',
      [id]
    );
    
    if (attendanceRecords[0].count > 0) {
      // Deactivate instead of delete (preserve history)
      await connection.execute(
        'UPDATE users SET status = "tidak_aktif", updated_at = NOW() WHERE id = ?',
        [id]
      );
      await connection.execute(
        'UPDATE siswa SET status = "tidak_aktif", updated_at = NOW() WHERE user_id = ?',
        [id]
      );
      
      await connection.commit();
      
      res.json({ 
        success: true,
        message: 'Student account deactivated (has attendance records)',
        action: 'deactivated'
      });
    } else {
      // Safe to hard delete - no attendance records
      await connection.execute('DELETE FROM siswa WHERE user_id = ?', [id]);
      await connection.execute('DELETE FROM users WHERE id = ?', [id]);
      
      await connection.commit();
      
      res.json({ 
        success: true,
        message: 'Student account deleted successfully',
        action: 'deleted'
      });
    }
    
  } catch (error) {
    if (connection) await connection.rollback();
    console.error('Delete student error:', error);
    res.status(500).json({ error: 'Failed to delete student' });
  } finally {
    if (connection) connection.release();
  }
});
```

### GET /api/admin/siswa-perwakilan - List Students (UPDATED)
```javascript
// ✅ CORRECT: Use siswa table with LEFT JOIN to users
app.get('/api/admin/siswa-perwakilan', authenticateToken, requireRole(['admin']), async (req, res) => {
  try {
    const [students] = await db.execute(`
      SELECT 
        s.id_siswa,
        s.nis,
        s.nama,
        s.kelas_id,
        s.jabatan,
        s.jenis_kelamin,
        s.email,
        s.status as siswa_status,
        u.id as user_id,
        u.username,
        u.email as user_email,
        u.status as user_status,
        k.nama_kelas,
        k.tingkat
      FROM siswa s
      LEFT JOIN users u ON s.user_id = u.id
      JOIN kelas k ON s.kelas_id = k.id_kelas
      WHERE s.status = 'aktif'
      ORDER BY s.nama
    `);
    
    res.json({ success: true, data: students });
    
  } catch (error) {
    console.error('Get students error:', error);
    res.status(500).json({ error: 'Failed to get students' });
  }
});
```

