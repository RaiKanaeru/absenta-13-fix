## 📊 Database Architecture (2025)

### **Core Tables** (19 active tables):

#### **1. User Management** (Normalized - Opsi 2)
```sql
-- users: Akun pengguna (ADMIN, GURU, SISWA)
CREATE TABLE users (
  id INT PRIMARY KEY AUTO_INCREMENT,
  username VARCHAR(50) UNIQUE NOT NULL,
  password VARCHAR(255) NOT NULL,
  role ENUM('ADMIN','GURU','SISWA') NOT NULL,
  email VARCHAR(100),
  nomor_telepon VARCHAR(20),
  status ENUM('aktif','tidak_aktif','ditangguhkan') DEFAULT 'aktif',
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

-- guru: Data guru (linked to users)
CREATE TABLE guru (
  id INT PRIMARY KEY AUTO_INCREMENT,
  id_guru INT UNIQUE NOT NULL,
  user_id INT NOT NULL,
  nip VARCHAR(30) NOT NULL,
  nama VARCHAR(100) NOT NULL,
  email VARCHAR(100),
  mapel_id INT,
  status ENUM('aktif','tidak_aktif','pensiun') DEFAULT 'aktif',
  FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
);

-- siswa: Data siswa (linked to users - NULLABLE)
CREATE TABLE siswa (
  id INT PRIMARY KEY AUTO_INCREMENT,
  id_siswa INT UNIQUE NOT NULL,
  user_id INT NULL,  -- ✅ NULLABLE: siswa bisa ada tanpa akun
  nis VARCHAR(30) UNIQUE NOT NULL,
  nama VARCHAR(100) NOT NULL,
  kelas_id INT NOT NULL,
  jabatan VARCHAR(50) DEFAULT 'Sekretaris Kelas',
  status ENUM('aktif','tidak_aktif','lulus','pindah') DEFAULT 'aktif',
  FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE SET NULL,
  FOREIGN KEY (kelas_id) REFERENCES kelas(id_kelas)
);

-- ✅ siswa_perwakilan: VIEW untuk backward compatibility
CREATE VIEW siswa_perwakilan AS SELECT * FROM siswa;
```

#### **2. Academic Structure**
```sql
-- kelas: Kelas sekolah
CREATE TABLE kelas (
  id_kelas INT PRIMARY KEY AUTO_INCREMENT,
  nama_kelas VARCHAR(50) UNIQUE NOT NULL,
  tingkat VARCHAR(10),
  jurusan_id INT,
  ruang VARCHAR(50),
  kode_ruang VARCHAR(20)
);

-- mapel: Mata pelajaran
CREATE TABLE mapel (
  id_mapel INT PRIMARY KEY AUTO_INCREMENT,
  nama_mapel VARCHAR(100) UNIQUE NOT NULL,
  kode_mapel VARCHAR(20)
);

-- jurusan: Program studi
CREATE TABLE jurusan (
  id_jurusan INT PRIMARY KEY AUTO_INCREMENT,
  nama_jurusan VARCHAR(100) UNIQUE NOT NULL,
  kode_jurusan VARCHAR(20)
);
```

#### **3. Multi-Teacher System** (NEW - 2025)
```sql
-- jadwal: Jadwal pelajaran (guru_id = primary teacher)
CREATE TABLE jadwal (
  id_jadwal INT PRIMARY KEY AUTO_INCREMENT,
  kelas_id INT NOT NULL,
  mapel_id INT NOT NULL,
  guru_id INT NOT NULL,  -- Primary teacher
  hari VARCHAR(10),
  jam_ke INT,
  jam_mulai TIME,
  jam_selesai TIME,
  status ENUM('aktif','tidak_aktif') DEFAULT 'aktif',
  FOREIGN KEY (kelas_id) REFERENCES kelas(id_kelas),
  FOREIGN KEY (mapel_id) REFERENCES mapel(id_mapel),
  FOREIGN KEY (guru_id) REFERENCES guru(id_guru)
);

-- jadwal_guru: Multi-teacher assignments (NEW)
CREATE TABLE jadwal_guru (
  id INT PRIMARY KEY AUTO_INCREMENT,
  jadwal_id INT NOT NULL,
  guru_id INT NOT NULL,
  is_primary TINYINT(1) DEFAULT 0,
  status ENUM('aktif','tidak_aktif') DEFAULT 'aktif',
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  UNIQUE KEY (jadwal_id, guru_id),
  FOREIGN KEY (jadwal_id) REFERENCES jadwal(id_jadwal) ON DELETE CASCADE,
  FOREIGN KEY (guru_id) REFERENCES guru(id_guru) ON DELETE CASCADE
);

-- absensi_guru_jadwal: Teacher attendance per schedule (NEW)
CREATE TABLE absensi_guru_jadwal (
  id INT PRIMARY KEY AUTO_INCREMENT,
  jadwal_id INT NOT NULL,
  guru_pencatat_id INT,
  tanggal DATE NOT NULL,
  jam_ke INT,
  status ENUM('Hadir','Tidak Hadir','Sakit','Izin'),
  keterangan TEXT,
  siswa_pencatat_id INT,
  metode_absen ENUM('manual','scan','otomatis'),
  waktu_catat TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  UNIQUE KEY (jadwal_id, tanggal),
  FOREIGN KEY (jadwal_id) REFERENCES jadwal(id_jadwal)
);

-- absensi_guru_mapping: Per-teacher attendance mapping (NEW)
CREATE TABLE absensi_guru_mapping (
  id INT PRIMARY KEY AUTO_INCREMENT,
  absensi_guru_jadwal_id INT NOT NULL,
  guru_id INT NOT NULL,
  status ENUM('Hadir','Tidak Hadir','Sakit','Izin'),
  keterangan TEXT,
  UNIQUE KEY (absensi_guru_jadwal_id, guru_id),
  FOREIGN KEY (absensi_guru_jadwal_id) REFERENCES absensi_guru_jadwal(id) ON DELETE CASCADE,
  FOREIGN KEY (guru_id) REFERENCES guru(id_guru) ON DELETE CASCADE
);
```

#### **4. Attendance System**
```sql
-- absensi_siswa: Student attendance
CREATE TABLE absensi_siswa (
  id INT PRIMARY KEY AUTO_INCREMENT,
  siswa_id INT NOT NULL,
  jadwal_id INT NOT NULL,
  tanggal DATE NOT NULL,
  status ENUM('Hadir','Izin','Sakit','Alpa','Dispen'),
  keterangan TEXT,
  waktu_absen TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (siswa_id) REFERENCES siswa(id_siswa),
  FOREIGN KEY (jadwal_id) REFERENCES jadwal(id_jadwal)
);

-- absensi_guru: Teacher attendance (legacy - still used)
CREATE TABLE absensi_guru (
  id_absensi INT PRIMARY KEY AUTO_INCREMENT,
  jadwal_id INT NOT NULL,
  guru_id INT NOT NULL,
  tanggal DATE NOT NULL,
  status ENUM('Hadir','Tidak Hadir','Sakit','Izin'),
  keterangan TEXT,
  FOREIGN KEY (jadwal_id) REFERENCES jadwal(id_jadwal),
  FOREIGN KEY (guru_id) REFERENCES guru(id_guru)
);
```

#### **5. Banding Absen System**
```sql
-- pengajuan_banding_absen: Attendance appeals
CREATE TABLE pengajuan_banding_absen (
  id_banding INT PRIMARY KEY AUTO_INCREMENT,
  siswa_id INT NOT NULL,
  jadwal_id INT NOT NULL,
  tanggal_absen DATE NOT NULL,
  status_asli ENUM('Hadir','Izin','Sakit','Alpa','Dispen','kelas'),
  status_diajukan ENUM('Hadir','Izin','Sakit','Alpa','Dispen','kelas'),
  alasan_banding TEXT NOT NULL,
  bukti_pendukung VARCHAR(255),
  status_banding ENUM('pending','disetujui','ditolak') DEFAULT 'pending',
  catatan_guru TEXT,
  tanggal_pengajuan TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  tanggal_keputusan TIMESTAMP NULL,
  diproses_oleh INT,
  kelas_id INT,
  jenis_banding ENUM('individual','kelas') DEFAULT 'individual',
  FOREIGN KEY (siswa_id) REFERENCES siswa(id_siswa),
  FOREIGN KEY (jadwal_id) REFERENCES jadwal(id_jadwal),
  FOREIGN KEY (diproses_oleh) REFERENCES guru(id_guru)
);

-- banding_absen_detail: Class appeal details
CREATE TABLE banding_absen_detail (
  id_detail INT PRIMARY KEY AUTO_INCREMENT,
  banding_id INT NOT NULL,
  nama_siswa VARCHAR(100) NOT NULL,
  status_asli ENUM('Hadir','Izin','Sakit','Alpa','Dispen'),
  status_diajukan ENUM('Hadir','Izin','Sakit','Alpa','Dispen'),
  alasan_banding TEXT NOT NULL,
  bukti_pendukung VARCHAR(255),
  FOREIGN KEY (banding_id) REFERENCES pengajuan_banding_absen(id_banding) ON DELETE CASCADE
);
```

