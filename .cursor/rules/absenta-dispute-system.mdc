## 📊 Dispute Analytics

### Dispute Statistics
```javascript
const disputeAnalytics = {
  // 1. Get dispute statistics
  getDisputeStats: async (startDate, endDate) => {
    const [stats] = await db.execute(`
      SELECT 
        COUNT(*) as total_disputes,
        SUM(CASE WHEN status_banding = 'pending' THEN 1 ELSE 0 END) as pending_disputes,
        SUM(CASE WHEN status_banding = 'dikabulkan' THEN 1 ELSE 0 END) as approved_disputes,
        SUM(CASE WHEN status_banding = 'ditolak' THEN 1 ELSE 0 END) as rejected_disputes,
        (SUM(CASE WHEN status_banding = 'dikabulkan' THEN 1 ELSE 0 END) / COUNT(*)) * 100 as approval_rate
      FROM banding_absen 
      WHERE tanggal_pengajuan BETWEEN ? AND ?
    `, [startDate, endDate]);
    
    return stats[0];
  },
  
  // 2. Get dispute trends
  getDisputeTrends: async (days = 30) => {
    const [trends] = await db.execute(`
      SELECT 
        DATE(tanggal_pengajuan) as tanggal,
        COUNT(*) as total_disputes,
        SUM(CASE WHEN status_banding = 'dikabulkan' THEN 1 ELSE 0 END) as approved,
        SUM(CASE WHEN status_banding = 'ditolak' THEN 1 ELSE 0 END) as rejected
      FROM banding_absen 
      WHERE tanggal_pengajuan >= DATE_SUB(CURDATE(), INTERVAL ? DAY)
      GROUP BY DATE(tanggal_pengajuan)
      ORDER BY tanggal DESC
    `, [days]);
    
    return trends;
  }
};
```

## 🚨 Error Handling for Disputes

### Dispute Error Handling
```javascript
const disputeErrorHandling = {
  // 1. Validate dispute data
  validateDisputeData: (data) => {
    const errors = [];
    
    if (!data.absensiId) {
      errors.push('Attendance ID is required');
    }
    
    if (!data.siswaId) {
      errors.push('Student ID is required');
    }
    
    if (!data.guruId) {
      errors.push('Teacher ID is required');
    }
    
    if (!data.statusDiajukan) {
      errors.push('Proposed status is required');
    }
    
    if (!data.alasanBanding || data.alasanBanding.trim().length < 10) {
      errors.push('Reason must be at least 10 characters long');
    }
    
    return errors;
  },
  
  // 2. Check dispute eligibility
  checkDisputeEligibility: async (absensiId, siswaId) => {
    try {
      // Check if dispute already exists
      const [existing] = await db.execute(
        'SELECT id_banding FROM banding_absen WHERE absensi_id = ? AND siswa_id = ?',
        [absensiId, siswaId]
      );
      
      if (existing.length > 0) {
        return {
          eligible: false,
          reason: 'Dispute already exists for this attendance record'
        };
      }
      
      // Check if attendance record exists
      const [attendance] = await db.execute(
        'SELECT * FROM absensi_siswa WHERE id = ? AND siswa_id = ?',
        [absensiId, siswaId]
      );
      
      if (attendance.length === 0) {
        return {
          eligible: false,
          reason: 'Attendance record not found'
        };
      }
      
      // Check if dispute is within time limit (e.g., 7 days)
      const attendanceDate = new Date(attendance[0].tanggal);
      const now = new Date();
      const daysDiff = (now - attendanceDate) / (1000 * 60 * 60 * 24);
      
      if (daysDiff > 7) {
        return {
          eligible: false,
          reason: 'Dispute must be submitted within 7 days'
        };
      }
      
      return { eligible: true };
      
    } catch (error) {
      console.error('Error checking dispute eligibility:', error);
      return {
        eligible: false,
        reason: 'Error checking eligibility'
      };
    }
  }
};
```

## 📋 API Endpoints for Disputes

### Dispute API Endpoints
```javascript
// 1. Create dispute
app.post('/api/disputes', authenticateToken, async (req, res) => {
  try {
    const disputeData = req.body;
    
    // Validate data
    const errors = disputeErrorHandling.validateDisputeData(disputeData);
    if (errors.length > 0) {
      return res.status(400).json(errorResponses.validation(errors));
    }
    
    // Check eligibility
    const eligibility = await disputeErrorHandling.checkDisputeEligibility(
      disputeData.absensiId, 
      disputeData.siswaId
    );
    
    if (!eligibility.eligible) {
      return res.status(400).json(errorResponses.validation([eligibility.reason]));
    }
    
    // Create dispute
    await disputeCreationLogic.createDispute(disputeData);
    
    res.success(null, 'Dispute created successfully');
  } catch (error) {
    console.error('Error creating dispute:', error);
    res.error('Failed to create dispute', error.message);
  }
});

// 2. Process dispute
app.post('/api/disputes/:id/process', authenticateToken, async (req, res) => {
  try {
    const { id } = req.params;
    const { decision, keterangan } = req.body;
    
    if (!['dikabulkan', 'ditolak'].includes(decision)) {
      return res.status(400).json(errorResponses.validation(['Invalid decision']));
    }
    
    await disputeProcessingLogic.processDisputeDecision(
      id, 
      decision, 
      keterangan, 
      req.user.id
    );
    
    res.success(null, 'Dispute processed successfully');
  } catch (error) {
    console.error('Error processing dispute:', error);
    res.error('Failed to process dispute', error.message);
  }
});

