app.get('/api/disputes/teacher/:teacherId', authenticateToken, async (req, res) => {
  try {
    const { teacherId } = req.params;
    const { status } = req.query;
    
    const disputes = await disputeProcessingLogic.getTeacherDisputes(teacherId, status);
    
    res.success(disputes, 'Teacher disputes retrieved successfully');
  } catch (error) {
    console.error('Error getting teacher disputes:', error);
    res.error('Failed to get teacher disputes', error.message);
  }
});
