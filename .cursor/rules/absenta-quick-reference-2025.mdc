## 🔑 Critical Patterns

### **1. Multi-Guru Query**
```sql
-- Get teacher's schedules (primary + additional)
SELECT j.* 
FROM jadwal j
LEFT JOIN jadwal_guru jg ON j.id_jadwal = jg.jadwal_id 
  AND jg.guru_id = ? AND jg.status = 'aktif'
WHERE (j.guru_id = ? OR jg.guru_id IS NOT NULL) 
  AND j.status = 'aktif'
```

### **2. Siswa with Nullable User**
```sql
-- ALWAYS use LEFT JOIN for user_id
SELECT s.*, u.username, u.email
FROM siswa s
LEFT JOIN users u ON s.user_id = u.id
WHERE s.id_siswa = ?
```

### **3. Transaction Pattern**
```javascript
let connection;
try {
  connection = await db.getConnection();
  await connection.beginTransaction();
  
  // Operations
  
  await connection.commit();
} catch (error) {
  await connection.rollback();
  throw error;
} finally {
  connection.release();
}
```

### **4. Daily Attendance Logic** ⭐ NEW
```sql
-- Aggregate per hari dengan priority logic
WITH daily_status AS (
    SELECT 
        s.id_siswa, s.nama, ase.tanggal,
        CASE 
            -- Alpha → Tidak Hadir
            WHEN SUM(CASE WHEN ase.status = 'Alpa' THEN 1 ELSE 0 END) > 0 
                THEN 'Alpa'
            -- Dispen → Hadir (belajar bentuk lain)
            WHEN SUM(CASE WHEN ase.status = 'Dispen' THEN 1 ELSE 0 END) = COUNT(*) 
                THEN 'Dispen'
            -- Izin/Sakit → Hadir dengan status
            WHEN SUM(CASE WHEN ase.status IN ('Izin','Sakit') THEN 1 ELSE 0 END) = COUNT(*) 
                THEN 'Izin'
            -- Hadir
            WHEN SUM(CASE WHEN ase.status = 'Hadir' THEN 1 ELSE 0 END) > 0 
                THEN 'Hadir'
            ELSE 'Alpa'
        END as status_hari
    FROM siswa s
    LEFT JOIN absensi_siswa ase ON s.id_siswa = ase.siswa_id 
        AND ase.tanggal BETWEEN ? AND ?
    GROUP BY s.id_siswa, s.nama, ase.tanggal
)
SELECT 
    nama,
    SUM(CASE WHEN status_hari = 'Hadir' THEN 1 ELSE 0 END) as hadir,
    SUM(CASE WHEN status_hari = 'Dispen' THEN 1 ELSE 0 END) as dispen,
    COUNT(DISTINCT tanggal) as total_hari
FROM daily_status
WHERE tanggal IS NOT NULL
GROUP BY nama
```

