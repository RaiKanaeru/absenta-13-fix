## ⚠️ CRITICAL MISTAKE #5: Lupa Validate FK Relationships

### ❌ WRONG: Direct INSERT tanpa check
```javascript
// JANGAN LAKUKAN INI!
await db.execute(
  'INSERT INTO jadwal (kelas_id, mapel_id, guru_id, ...) VALUES (?, ?, ?, ...)',
  [kelasId, mapelId, guruId]
);
// ☠️ Jika kelas_id tidak ada, error FK constraint!
```

### ✅ CORRECT: Validate FK sebelum INSERT
```javascript
// SELALU VALIDATE FK DULU
let connection;
try {
  connection = await db.getConnection();
  await connection.beginTransaction();
  
  // Validate kelas exists
  const [kelas] = await connection.execute(
    'SELECT id_kelas FROM kelas WHERE id_kelas = ? AND status = "aktif"',
    [kelasId]
  );
  
  if (kelas.length === 0) {
    throw new Error('Kelas tidak ditemukan atau tidak aktif');
  }
  
  // Validate mapel exists
  const [mapel] = await connection.execute(
    'SELECT id_mapel FROM mapel WHERE id_mapel = ? AND status = "aktif"',
    [mapelId]
  );
  
  if (mapel.length === 0) {
    throw new Error('Mata pelajaran tidak ditemukan atau tidak aktif');
  }
  
  // Validate guru exists
  const [guru] = await connection.execute(
    'SELECT id_guru FROM guru WHERE id_guru = ? AND status = "aktif"',
    [guruId]
  );
  
  if (guru.length === 0) {
    throw new Error('Guru tidak ditemukan atau tidak aktif');
  }
  
  // Now safe to INSERT
  await connection.execute(
    'INSERT INTO jadwal (kelas_id, mapel_id, guru_id, ...) VALUES (?, ?, ?, ...)',
    [kelasId, mapelId, guruId]
  );
  
  await connection.commit();
  
} catch (error) {
  if (connection) await connection.rollback();
  throw error;
} finally {
  if (connection) connection.release();
}
```

