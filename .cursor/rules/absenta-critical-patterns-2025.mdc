## ⚠️ CRITICAL MISTAKE #4: Hard Delete dengan History

### ❌ WRONG: Direct DELETE
```javascript
// JANGAN LAKUKAN INI! (KEHILANGAN HISTORY)
await db.execute('DELETE FROM siswa WHERE id_siswa = ?', [siswaId]);
```

### ✅ CORRECT: Smart Delete (Check History First)
```javascript
// SELALU CEK HISTORY DULU
let connection;
try {
  connection = await db.getConnection();
  await connection.beginTransaction();
  
  // Check if has attendance history
  const [attendance] = await connection.execute(
    'SELECT COUNT(*) as count FROM absensi_siswa WHERE siswa_id = ?',
    [siswaId]
  );
  
  // Check if has banding history
  const [banding] = await connection.execute(
    'SELECT COUNT(*) as count FROM pengajuan_banding_absen WHERE siswa_id = ?',
    [siswaId]
  );
  
  const hasHistory = attendance[0].count > 0 || banding[0].count > 0;
  
  if (hasHistory) {
    // Soft delete (preserve history)
    await connection.execute(
      'UPDATE siswa SET status = "tidak_aktif" WHERE id_siswa = ?',
      [siswaId]
    );
    
    if (userId) {
      await connection.execute(
        'UPDATE users SET status = "tidak_aktif" WHERE id = ?',
        [userId]
      );
    }
    
    console.log('Soft delete - History preserved');
    
  } else {
    // Hard delete (no history)
    await connection.execute('DELETE FROM siswa WHERE id_siswa = ?', [siswaId]);
    
    if (userId) {
      await connection.execute('DELETE FROM users WHERE id = ?', [userId]);
    }
    
    console.log('Hard delete - No history');
  }
  
  await connection.commit();
  
} catch (error) {
  if (connection) await connection.rollback();
  throw error;
} finally {
  if (connection) connection.release();
}
```

