## ⚠️ CRITICAL MISTAKE #1: Lupa Multi-Guru Logic

### ❌ WRONG: Hanya query primary teacher
```javascript
// JANGAN LAKUKAN INI!
const [jadwal] = await db.execute(
  'SELECT * FROM jadwal WHERE guru_id = ?',
  [guruId]
);
```

### ✅ CORRECT: Include additional teachers
```javascript
// SELALU GUNAKAN PATTERN INI
const [jadwal] = await db.execute(
  `SELECT DISTINCT j.* 
   FROM jadwal j
   LEFT JOIN jadwal_guru jg ON j.id_jadwal = jg.jadwal_id 
     AND jg.guru_id = ? AND jg.status = 'aktif'
   WHERE (j.guru_id = ? OR jg.guru_id IS NOT NULL) 
     AND j.status = 'aktif'`,
  [guruId, guruId]
);
```

### ✅ BEST: With full schedule details
```javascript
const [jadwal] = await db.execute(
  `SELECT DISTINCT j.*, 
          k.nama_kelas, 
          m.nama_mapel,
          g_primary.nama as guru_utama,
          GROUP_CONCAT(DISTINCT g_all.nama ORDER BY g_all.nama SEPARATOR ', ') as semua_guru
   FROM jadwal j
   JOIN kelas k ON j.kelas_id = k.id_kelas
   JOIN mapel m ON j.mapel_id = m.id_mapel
   LEFT JOIN guru g_primary ON j.guru_id = g_primary.id_guru
   LEFT JOIN jadwal_guru jg ON j.id_jadwal = jg.jadwal_id AND jg.status = 'aktif'
   LEFT JOIN guru g_all ON jg.guru_id = g_all.id_guru
   WHERE (j.guru_id = ? OR jg.guru_id = ?) 
     AND j.status = 'aktif'
   GROUP BY j.id_jadwal`,
  [guruId, guruId]
);
```

