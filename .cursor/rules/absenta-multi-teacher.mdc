## 📊 Multi-Teacher Analytics

### Multi-Teacher Statistics
```javascript
const multiTeacherAnalytics = {
  // 1. Get multi-teacher statistics
  getMultiTeacherStats: async (startDate, endDate) => {
    const [stats] = await db.execute(`
      SELECT 
        COUNT(DISTINCT j.id_jadwal) as total_schedules,
        COUNT(DISTINCT j.guru_id) as primary_teachers,
        COUNT(DISTINCT jgt.guru_id) as additional_teachers,
        AVG(teacher_count.teacher_count) as avg_teachers_per_schedule
      FROM jadwal j
      LEFT JOIN jadwal_guru_tambahan jgt ON j.id_jadwal = jgt.jadwal_id AND jgt.status = 'aktif'
      LEFT JOIN (
        SELECT 
          j.id_jadwal,
          COUNT(DISTINCT j.guru_id) + COUNT(DISTINCT jgt.guru_id) as teacher_count
        FROM jadwal j
        LEFT JOIN jadwal_guru_tambahan jgt ON j.id_jadwal = jgt.jadwal_id AND jgt.status = 'aktif'
        GROUP BY j.id_jadwal
      ) teacher_count ON j.id_jadwal = teacher_count.id_jadwal
      WHERE j.created_at BETWEEN ? AND ?
    `, [startDate, endDate]);
    
    return stats[0];
  },
  
  // 2. Get teacher workload distribution
  getTeacherWorkloadDistribution: async (startDate, endDate) => {
    const [workload] = await db.execute(`
      SELECT 
        g.nama as nama_guru,
        g.nip,
        COUNT(DISTINCT j.id_jadwal) as primary_schedules,
        COUNT(DISTINCT jgt.jadwal_id) as additional_schedules,
        COUNT(DISTINCT j.id_jadwal) + COUNT(DISTINCT jgt.jadwal_id) as total_schedules
      FROM guru g
      LEFT JOIN jadwal j ON g.id_guru = j.guru_id
      LEFT JOIN jadwal_guru_tambahan jgt ON g.id_guru = jgt.guru_id AND jgt.status = 'aktif'
      WHERE g.status = 'aktif'
      GROUP BY g.id_guru, g.nama, g.nip
      ORDER BY total_schedules DESC
    `);
    
    return workload;
  }
};
```

## 📋 API Endpoints for Multi-Teacher

### Multi-Teacher API Endpoints
```javascript
// 1. Assign additional teachers to schedule
app.post('/api/schedules/:id/teachers', authenticateToken, async (req, res) => {
  try {
    const { id } = req.params;
    const { guru_id, role } = req.body;
    
    await multiTeacherAssignmentLogic.assignAdditionalTeachers(id, [{
      guru_id,
      role: role || 'secondary'
    }]);
    
    res.success(null, 'Teacher assigned successfully');
  } catch (error) {
    console.error('Error assigning teacher:', error);
    res.error('Failed to assign teacher', error.message);
  }
});

// 2. Get schedule teachers
app.get('/api/schedules/:id/teachers', authenticateToken, async (req, res) => {
  try {
    const { id } = req.params;
    
    const teachers = await multiTeacherAssignmentLogic.getScheduleTeachers(id);
    
    res.success(teachers, 'Schedule teachers retrieved successfully');
  } catch (error) {
    console.error('Error getting schedule teachers:', error);
    res.error('Failed to get schedule teachers', error.message);
  }
});

// 3. Record multi-teacher attendance
app.post('/api/attendance/teacher', authenticateToken, async (req, res) => {
  try {
    const attendanceData = req.body;
    
    await multiTeacherAttendanceLogic.recordTeacherAttendance({
      ...attendanceData,
      dikonfirmasiOleh: req.user.id
    });
    
    res.success(null, 'Teacher attendance recorded successfully');
  } catch (error) {
    console.error('Error recording teacher attendance:', error);
    res.error('Failed to record teacher attendance', error.message);
  }
});

