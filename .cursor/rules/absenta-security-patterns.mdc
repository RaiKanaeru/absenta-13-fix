### Authentication Flow Security
```javascript
// Secure login implementation
async function secureLogin(username, password) {
  try {
    // 1. Input validation
    if (!username || !password) {
      throw new Error('Username and password are required');
    }
    
    // 2. Rate limiting check
    const rateLimitKey = `login:${req.ip}`;
    const attempts = await redis.get(rateLimitKey);
    if (attempts && parseInt(attempts) >= 5) {
      throw new Error('Too many login attempts');
    }
    
    // 3. User lookup with status check
    const [users] = await db.execute(
      `SELECT * FROM pengguna 
       WHERE nama_pengguna = ? 
       AND (status IN ("aktif", "active", "1", "1") OR status IS NULL)`,
      [username]
    );
    
    if (users.length === 0) {
      // Increment rate limit counter
      await redis.incr(rateLimitKey);
      await redis.expire(rateLimitKey, 900); // 15 minutes
      throw new Error('Invalid credentials');
    }
    
    const user = users[0];
    
    // 4. Password verification with pepper
    const passwordWithPepper = password + PASSWORD_PEPPER;
    const isValidPassword = await bcrypt.compare(passwordWithPepper, user.kata_sandi);
    
    if (!isValidPassword) {
      // Increment rate limit counter
      await redis.incr(rateLimitKey);
      await redis.expire(rateLimitKey, 900);
      throw new Error('Invalid credentials');
    }
    
    // 5. Generate secure token
    const token = jwt.sign(
      {
        id: user.id,
        username: user.nama_pengguna,
        role: user.peran,
        iat: Math.floor(Date.now() / 1000)
      },
      JWT_SECRET,
      { expiresIn: '24h' }
    );
    
    // 6. Clear rate limit on successful login
    await redis.del(rateLimitKey);
    
    // 7. Log successful login
    console.log(`✅ Successful login: ${user.nama_pengguna} (${user.peran})`);
    
    return {
      success: true,
      token,
      user: {
        id: user.id,
        username: user.nama_pengguna,
        role: user.peran,
        nama: user.nama
      }
    };
    
  } catch (error) {
    console.error('❌ Login error:', error.message);
    throw error;
  }
}
```

## 🛡️ Authorization Security

### Role-Based Access Control (RBAC)
```javascript
const rbacSecurity = {
  // 1. Role definitions
  roles: {
    admin: {
      level: 3,
      permissions: [
        'user.create', 'user.read', 'user.update', 'user.delete',
        'schedule.create', 'schedule.read', 'schedule.update', 'schedule.delete',
        'attendance.create', 'attendance.read', 'attendance.update', 'attendance.delete',
        'report.generate', 'system.configure', 'data.import', 'data.export'
      ]
    },
    guru: {
      level: 2,
      permissions: [
        'schedule.read', 'attendance.create', 'attendance.read',
        'student.read', 'report.generate.own'
      ]
    },
    siswa: {
      level: 1,
      permissions: [
        'schedule.read', 'attendance.read.own', 'profile.update.own'
      ]
    }
  },
  
  // 2. Permission checking
  checkPermission: (userRole, requiredPermission) => {
    const role = rbacSecurity.roles[userRole];
    if (!role) return false;
    return role.permissions.includes(requiredPermission);
  }
};
```

### Authorization Middleware
```javascript
// Secure authentication middleware
function authenticateToken(req, res, next) {
  const authHeader = req.headers['authorization'];
  const token = authHeader && authHeader.split(' ')[1] || req.cookies.token;
  
  if (!token) {
    return res.status(401).json({ 
      success: false,
      error: 'Access token required',
      message: 'Please provide a valid authentication token'
    });
  }

  jwt.verify(token, JWT_SECRET, (err, user) => {
    if (err) {
      console.log('❌ Token verification failed:', err.message);
      return res.status(403).json({ 
        success: false,
        error: 'Invalid or expired token',
        message: 'Please login again'
      });
    }
    
    // Additional security checks
    if (!user.id || !user.username || !user.role) {
      return res.status(403).json({ 
        success: false,
        error: 'Invalid token payload',
        message: 'Token contains invalid data'
      });
    }
    
    console.log(`✅ Token verified for user: ${user.username} (${user.role})`);
    req.user = user;
    next();
  });
}

// Role-based authorization middleware
function requireRole(roles) {
  return (req, res, next) => {
    if (!req.user) {
      return res.status(401).json({ 
        success: false,
        error: 'Authentication required',
        message: 'Please login first'
      });
    }
    
    if (!roles.includes(req.user.role)) {
      console.log(`❌ Access denied: ${req.user.username} (${req.user.role}) attempted to access ${req.path}`);
      return res.status(403).json({ 
        success: false,
        error: 'Insufficient permissions',
        message: 'You do not have permission to access this resource'
      });
    }
    
    next();
  };
}
```

## 🛡️ Data Protection Security

### SQL Injection Prevention
```javascript
const sqlInjectionPrevention = {
  // 1. Always use parameterized queries
  secureQuery: async (query, params) => {
    try {
      // Validate query structure
      if (!query || typeof query !== 'string') {
        throw new Error('Invalid query');
      }
      
      // Validate parameters
      if (!Array.isArray(params)) {
        throw new Error('Parameters must be an array');
      }
      
      // Execute with parameterized query
      const [rows] = await db.execute(query, params);
      return rows;
    } catch (error) {
      console.error('❌ SQL query error:', error);
      throw new Error('Database query failed');
    }
  },
  
  // 2. Input sanitization
  sanitizeInput: (input) => {
    if (typeof input !== 'string') return input;
    
    // Remove potentially dangerous characters
    return input
      .replace(/[<>]/g, '') // Remove HTML tags
      .replace(/['"]/g, '') // Remove quotes
      .replace(/[;]/g, '') // Remove semicolons
      .trim();
  },
  
  // 3. Query validation
  validateQuery: (query) => {
    const dangerousPatterns = [
      /DROP\s+TABLE/i,
      /DELETE\s+FROM/i,
      /UPDATE\s+.*\s+SET/i,
      /INSERT\s+INTO/i,
      /ALTER\s+TABLE/i,
      /CREATE\s+TABLE/i,
      /UNION\s+SELECT/i,
      /OR\s+1\s*=\s*1/i
    ];
    
    for (const pattern of dangerousPatterns) {
      if (pattern.test(query)) {
        throw new Error('Potentially dangerous query detected');
      }
    }
    
    return true;
  }
};
```

### XSS Prevention
```javascript
const xssPrevention = {
  // 1. Input sanitization
  sanitizeHtml: (input) => {
    if (typeof input !== 'string') return input;
    
    // Remove HTML tags
    return input
      .replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '')
      .replace(/<[^>]*>/g, '')
      .replace(/javascript:/gi, '')
      .replace(/on\w+\s*=/gi, '');
  },
  
  // 2. Output encoding
  encodeOutput: (input) => {
    if (typeof input !== 'string') return input;
    
    return input
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#x27;')
      .replace(/\//g, '&#x2F;');
  },
  
  // 3. Content Security Policy
  cspHeaders: {
    'Content-Security-Policy': "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
  }
};
```

### Data Encryption
```javascript
const dataEncryption = {
  // 1. Sensitive data encryption
  encryptSensitiveData: (data) => {
    const algorithm = 'aes-256-gcm';
    const key = crypto.scryptSync(process.env.ENCRYPTION_KEY, 'salt', 32);
    const iv = crypto.randomBytes(16);
    
    const cipher = crypto.createCipher(algorithm, key);
    cipher.setAAD(Buffer.from('absenta-data', 'utf8'));
    
    let encrypted = cipher.update(data, 'utf8', 'hex');
    encrypted += cipher.final('hex');
    
    const authTag = cipher.getAuthTag();
    
    return {
      encrypted,
      iv: iv.toString('hex'),
      authTag: authTag.toString('hex')
    };
  },
  
  // 2. Data decryption
  decryptSensitiveData: (encryptedData) => {
    const algorithm = 'aes-256-gcm';
    const key = crypto.scryptSync(process.env.ENCRYPTION_KEY, 'salt', 32);
    const iv = Buffer.from(encryptedData.iv, 'hex');
    
    const decipher = crypto.createDecipher(algorithm, key);
    decipher.setAAD(Buffer.from('absenta-data', 'utf8'));
    decipher.setAuthTag(Buffer.from(encryptedData.authTag, 'hex'));
    
    let decrypted = decipher.update(encryptedData.encrypted, 'hex', 'utf8');
    decrypted += decipher.final('utf8');
    
    return decrypted;
  }
};
```

