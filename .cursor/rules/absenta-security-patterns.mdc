    if (typeof input !== 'string') return input;
    
    return input
      .replace(/['"]/g, '')
      .replace(/[;]/g, '')
      .replace(/--/g, '')
      .replace(/\/\*/g, '')
      .replace(/\*\//g, '')
      .trim();
  },
  
  // 3. XSS prevention
  preventXss: (input) => {
    if (typeof input !== 'string') return input;
    
    return input
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#x27;')
      .replace(/\//g, '&#x2F;');
  }
};
```

## 🔐 Session Security

### Session Management
```javascript
const sessionSecurity = {
  // 1. Session configuration
  sessionConfig: {
    secret: process.env.SESSION_SECRET || 'absenta-session-secret',
    resave: false,
    saveUninitialized: false,
    cookie: {
      secure: process.env.NODE_ENV === 'production',
      httpOnly: true,
      maxAge: 24 * 60 * 60 * 1000, // 24 hours
      sameSite: 'strict'
    }
  },
  
  // 2. Session validation
  validateSession: (req, res, next) => {
    if (req.session && req.session.user) {
      // Check if session is still valid
      const sessionAge = Date.now() - req.session.createdAt;
      const maxAge = 24 * 60 * 60 * 1000; // 24 hours
      
      if (sessionAge > maxAge) {
        req.session.destroy();
        return res.status(401).json({
          success: false,
          error: 'Session expired',
          message: 'Please login again'
        });
      }
      
      next();
    } else {
      return res.status(401).json({
        success: false,
        error: 'Session required',
        message: 'Please login first'
      });
    }
  }
};
```

## 🚨 Security Monitoring

### Security Logging
```javascript
const securityLogging = {
  // 1. Security event logging
  logSecurityEvent: (event, details) => {
    const logEntry = {
      timestamp: new Date().toISOString(),
      event,
      details,
      ip: details.ip || 'unknown',
      userAgent: details.userAgent || 'unknown',
      severity: details.severity || 'info'
    };
    
    console.log(`🔒 Security Event: ${event}`, logEntry);
    
    // Store in security log file
    fs.appendFileSync('security.log', JSON.stringify(logEntry) + '\n');
  },
  
  // 2. Failed login attempts
  logFailedLogin: (username, ip, userAgent) => {
    securityLogging.logSecurityEvent('FAILED_LOGIN', {
      username,
      ip,
      userAgent,
      severity: 'warning'
    });
  },
  
  // 3. Suspicious activity
  logSuspiciousActivity: (activity, details) => {
    securityLogging.logSecurityEvent('SUSPICIOUS_ACTIVITY', {
      activity,
      ...details,
      severity: 'high'
    });
  }
};
```

### Security Alerts
```javascript
const securityAlerts = {
  // 1. Alert configuration
  alertConfig: {
    maxFailedLogins: 5,
    maxSuspiciousActivities: 3,
    alertCooldown: 300000 // 5 minutes
  },
  
  // 2. Alert triggers
  checkAlerts: (event, details) => {
    switch (event) {
      case 'FAILED_LOGIN':
        if (details.count >= securityAlerts.alertConfig.maxFailedLogins) {
          securityAlerts.sendAlert('Multiple failed login attempts', details);
        }
        break;
      
      case 'SUSPICIOUS_ACTIVITY':
        if (details.count >= securityAlerts.alertConfig.maxSuspiciousActivities) {
          securityAlerts.sendAlert('Suspicious activity detected', details);
        }
        break;
    }
  },
  
  // 3. Alert sending
  sendAlert: (message, details) => {
    console.log(`🚨 SECURITY ALERT: ${message}`, details);
    
    // Send to admin notification system
    // This could be email, SMS, or webhook
    if (process.env.ADMIN_EMAIL) {
      // Send email alert
      sendEmailAlert(message, details);
    }
  }
};
```

## 🔧 Security Configuration

### Environment Security
```javascript
const environmentSecurity = {
  // 1. Required environment variables
  requiredEnvVars: [
    'JWT_SECRET',
    'DB_PASSWORD',
    'NODE_ENV'
  ],
  
  // 2. Environment validation
  validateEnvironment: () => {
    const missing = environmentSecurity.requiredEnvVars.filter(
      varName => !process.env[varName]
    );
    
    if (missing.length > 0) {
      console.error('❌ Missing required environment variables:', missing);
      process.exit(1);
    }
    
    // Validate JWT secret strength
    if (process.env.JWT_SECRET && process.env.JWT_SECRET.length < 32) {
      console.error('❌ JWT_SECRET must be at least 32 characters long');
      process.exit(1);
    }
  },
  
  // 3. Production security checks
  productionChecks: () => {
    if (process.env.NODE_ENV === 'production') {
      // Check for secure configurations
      if (!process.env.JWT_SECRET || process.env.JWT_SECRET.length < 32) {
        console.error('❌ Production requires strong JWT_SECRET');
        process.exit(1);
      }
      
      if (process.env.DB_PASSWORD === 'password') {
        console.error('❌ Production requires secure database password');
        process.exit(1);
      }
    }
  }
};
```

### Security Headers
```javascript
const securityHeaders = {
  // 1. Security middleware
  securityMiddleware: (req, res, next) => {
    // Set security headers
    res.setHeader('X-Content-Type-Options', 'nosniff');
    res.setHeader('X-Frame-Options', 'DENY');
    res.setHeader('X-XSS-Protection', '1; mode=block');
    res.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
    res.setHeader('Permissions-Policy', 'geolocation=(), microphone=(), camera=()');
    
    // HTTPS only in production
    if (process.env.NODE_ENV === 'production') {
      res.setHeader('Strict-Transport-Security', 'max-age=31536000; includeSubDomains');
    }
    
    next();
  },
  
  // 2. Content Security Policy
  cspMiddleware: (req, res, next) => {
    const csp = [
      "default-src 'self'",
      "script-src 'self' 'unsafe-inline'",
      "style-src 'self' 'unsafe-inline'",
      "img-src 'self' data:",
      "font-src 'self'",
      "connect-src 'self'",
      "frame-ancestors 'none'"
    ].join('; ');
    
    res.setHeader('Content-Security-Policy', csp);
    next();
  }
};
```

