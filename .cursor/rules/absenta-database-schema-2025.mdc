## 🔗 Relationships (Updated 2025)

```
users (Akun)
├── guru (1:1 via user_id) [REQUIRED]
└── siswa (1:1 via user_id) [OPTIONAL]

siswa (Data)
├── kelas (N:1 via kelas_id) [REQUIRED]
├── users (1:1 via user_id) [OPTIONAL]
└── absensi_siswa (1:N via id_siswa)

jadwal (Schedule)
├── guru (N:1 via guru_id) [Primary Teacher]
├── jadwal_guru (1:N) [Multi-Teacher Assignments]
├── kelas (N:1 via kelas_id)
├── mapel (N:1 via mapel_id)
└── absensi_siswa (1:N via id_jadwal)

jadwal_guru (Multi-Teacher)
├── jadwal (N:1 via jadwal_id)
├── guru (N:1 via guru_id)
└── absensi_guru_jadwal (1:N)
```

## 🚨 QUERY PATTERNS (UPDATED 2025)

### ❌ DEPRECATED PATTERNS (DO NOT USE)
```sql
-- DON'T USE: siswa_perwakilan as main table
SELECT * FROM siswa_perwakilan WHERE id_siswa = ?;

-- DON'T USE: Old role values
SELECT * FROM users WHERE role IN ('KETOS', 'perwakilan');

-- DON'T USE: Assuming user_id is NOT NULL
SELECT * FROM siswa WHERE user_id = ?;
```

### ✅ CORRECT PATTERNS (USE THESE)
```sql
-- 1. Get student with user account (if exists)
SELECT 
  s.*,
  u.username,
  u.email,
  u.status as user_status
FROM siswa s
LEFT JOIN users u ON s.user_id = u.id
WHERE s.id_siswa = ?;

-- 2. Get all students with role check
SELECT 
  s.*,
  u.username,
  u.role
FROM siswa s
LEFT JOIN users u ON s.user_id = u.id AND u.role = 'SISWA'
WHERE s.status = 'aktif';

-- 3. Student login authentication
SELECT 
  u.*,
  s.id_siswa,
  s.nis,
  s.nama,
  s.kelas_id
FROM users u
JOIN siswa s ON u.id = s.user_id
WHERE u.username = ? 
  AND u.role = 'SISWA'
  AND u.status = 'aktif';

-- 4. Get schedule with all teachers (multi-teacher)
SELECT 
  j.id_jadwal,
  j.hari,
  j.jam_mulai,
  j.jam_selesai,
  m.nama_mapel,
  k.nama_kelas,
  g_primary.nama as guru_utama,
  GROUP_CONCAT(g_all.nama SEPARATOR ', ') as semua_guru
FROM jadwal j
JOIN mapel m ON j.mapel_id = m.id_mapel
JOIN kelas k ON j.kelas_id = k.id_kelas
LEFT JOIN guru g_primary ON j.guru_id = g_primary.id_guru
LEFT JOIN jadwal_guru jg ON j.id_jadwal = jg.jadwal_id
LEFT JOIN guru g_all ON jg.guru_id = g_all.id_guru
WHERE j.id_jadwal = ?
GROUP BY j.id_jadwal;
```

## 📋 Backend Code Patterns (Updated 2025)

### POST /api/admin/siswa - Create Student
```javascript
// ✅ CORRECT: Auto-create user account in transaction
await db.withTransaction(async (connection) => {
  // 1. Create user account
  const [userResult] = await connection.execute(
    'INSERT INTO users (username, password, role, email, status) VALUES (?, ?, "SISWA", ?, "aktif")',
    [`siswa_${nis}`, hashedPassword, email]
  );
  
  const userId = userResult.insertId;
  
  // 2. Create siswa record
  await connection.execute(
    'INSERT INTO siswa (user_id, nis, nama, kelas_id, status) VALUES (?, ?, ?, ?, "aktif")',
    [userId, nis, nama, kelas_id]
  );
});
```

### PUT /api/admin/students/:id - Update Student
```javascript
// ✅ CORRECT: Update both tables atomically
await db.withTransaction(async (connection) => {
  // Update user account
  await connection.execute(
    'UPDATE users SET username = ?, email = ? WHERE id = ? AND role = "SISWA"',
    [username, email, userId]
  );
  
  // Update siswa data
  await connection.execute(
    'UPDATE siswa SET nis = ?, nama = ?, kelas_id = ? WHERE user_id = ?',
    [nis, nama, kelas_id, userId]
  );
});
```

### DELETE /api/admin/students/:id - Delete Student
```javascript
// ✅ CORRECT: Smart delete (deactivate if has history)
await db.withTransaction(async (connection) => {
  // Check for attendance records
  const [attendance] = await connection.execute(
    'SELECT COUNT(*) as count FROM absensi_siswa WHERE siswa_id IN (SELECT id_siswa FROM siswa WHERE user_id = ?)',
    [userId]
  );
  
  if (attendance[0].count > 0) {
    // Deactivate (preserve history)
    await connection.execute('UPDATE users SET status = "tidak_aktif" WHERE id = ?', [userId]);
    await connection.execute('UPDATE siswa SET status = "tidak_aktif" WHERE user_id = ?', [userId]);
  } else {
    // Hard delete (no history)
    await connection.execute('DELETE FROM siswa WHERE user_id = ?', [userId]);
    await connection.execute('DELETE FROM users WHERE id = ?', [userId]);
  }
});
```

### POST /api/login - Student Login
```javascript
// ✅ CORRECT: Support 'SISWA' role with backward compatibility
if (user.role === 'siswa' || user.role === 'SISWA' || user.role === 'perwakilan') {
  const [siswaData] = await db.execute(
    'SELECT s.*, k.nama_kelas FROM siswa s JOIN kelas k ON s.kelas_id = k.id_kelas WHERE s.user_id = ?',
    [user.id]
  );
  
  // Normalize role to lowercase 'siswa' in JWT token
  const tokenPayload = {
    id: user.id,
    role: 'siswa', // Always lowercase in token
    siswa_id: siswaData[0].id_siswa,
    nis: siswaData[0].nis
  };
}
```

## 🔍 Data Validation (Required)

### Check Data Integrity
```sql
-- 1. No broken relationships (should be 0)
SELECT COUNT(*) as broken_count
FROM siswa s
WHERE s.user_id IS NOT NULL 
  AND NOT EXISTS (SELECT 1 FROM users u WHERE u.id = s.user_id);

-- 2. Consistent roles (should be 0)
SELECT COUNT(*) as invalid_roles
FROM siswa s
JOIN users u ON s.user_id = u.id
WHERE u.role <> 'SISWA';

-- 3. No duplicate usernames (should be 0)
SELECT username, COUNT(*) as count
FROM users
GROUP BY username
HAVING count > 1;

-- 4. Multi-teacher integrity
SELECT COUNT(*) as orphaned_jadwal_guru
FROM jadwal_guru jg
WHERE NOT EXISTS (SELECT 1 FROM jadwal j WHERE j.id_jadwal = jg.jadwal_id)
   OR NOT EXISTS (SELECT 1 FROM guru g WHERE g.id_guru = jg.guru_id);
```

