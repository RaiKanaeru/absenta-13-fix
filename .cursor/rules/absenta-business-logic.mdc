### Report Calculation Logic
```javascript
function calculateAttendanceRate(attendances) {
  const total = attendances.length;
  const present = attendances.filter(a => a.status === 'Hadir').length;
  return total > 0 ? (present / total) * 100 : 0;
}

function calculateAbsenceCount(attendances, status = 'Alpa') {
  return attendances.filter(a => a.status === status).length;
}

function determineWarningStatus(absenceCount) {
  if (absenceCount >= 25) return 'CRITICAL';
  if (absenceCount >= 20) return 'WARNING';
  if (absenceCount >= 15) return 'CAUTION';
  return 'NORMAL';
}
```

