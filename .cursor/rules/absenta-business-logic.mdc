# Absenta Business Logic Patterns

## 🏢 Core Business Rules

### User Role Hierarchy
```javascript
// Role-based access control
const ROLE_HIERARCHY = {
  admin: {
    level: 3,
    permissions: ['read', 'write', 'delete', 'manage_users', 'system_config'],
    canAccess: ['admin', 'guru', 'siswa']
  },
  guru: {
    level: 2,
    permissions: ['read', 'write', 'attendance_management'],
    canAccess: ['guru', 'siswa']
  },
  siswa: {
    level: 1,
    permissions: ['read'],
    canAccess: ['siswa']
  }
};

// Permission checking
const hasPermission = (userRole, requiredPermission) => {
  const role = ROLE_HIERARCHY[userRole];
  return role && role.permissions.includes(requiredPermission);
};
```

### Attendance Status Rules
```javascript
// Attendance status definitions
const ATTENDANCE_STATUS = {
  HADIR: 'hadir',
  TIDAK_HADIR: 'tidak_hadir',
  IZIN: 'izin',
  SAKIT: 'sakit',
  CUTI: 'cuti'
};

// Status validation rules
const validateAttendanceStatus = (status, keterangan) => {
  const rules = {
    [ATTENDANCE_STATUS.HADIR]: {
      requiresKeterangan: false,
      allowedKeterangan: ['Hadir tepat waktu', 'Hadir terlambat']
    },
    [ATTENDANCE_STATUS.TIDAK_HADIR]: {
      requiresKeterangan: true,
      allowedKeterangan: ['Alpa', 'Tidak ada keterangan']
    },
    [ATTENDANCE_STATUS.IZIN]: {
      requiresKeterangan: true,
      allowedKeterangan: ['Izin sakit', 'Izin keluarga', 'Izin pribadi']
    },
    [ATTENDANCE_STATUS.SAKIT]: {
      requiresKeterangan: true,
      allowedKeterangan: ['Sakit', 'Sakit dengan surat dokter']
    },
    [ATTENDANCE_STATUS.CUTI]: {
      requiresKeterangan: true,
      allowedKeterangan: ['Cuti tahunan', 'Cuti melahirkan', 'Cuti khusus']
    }
  };
  
  const rule = rules[status];
  if (!rule) return false;
  
  if (rule.requiresKeterangan && !keterangan) return false;
  if (keterangan && !rule.allowedKeterangan.includes(keterangan)) return false;
  
  return true;
};
```

## 📅 Schedule Management Logic

### Schedule Validation Rules
```javascript
// Schedule conflict detection
const detectScheduleConflicts = async (newSchedule) => {
  const { hari, jam_mulai, jam_selesai, kelas_id, guru_id } = newSchedule;
  
  // Check for class conflicts
  const classConflicts = await db.execute(`
    SELECT j.*, m.nama_mapel, g.nama_guru
    FROM jadwal j
    JOIN mapel m ON j.mapel_id = m.id
    JOIN guru g ON j.guru_id = g.id
    WHERE j.kelas_id = ? 
    AND j.hari = ?
    AND (
      (j.jam_mulai <= ? AND j.jam_selesai > ?) OR
      (j.jam_mulai < ? AND j.jam_selesai >= ?) OR
      (j.jam_mulai >= ? AND j.jam_selesai <= ?)
    )
  `, [kelas_id, hari, jam_mulai, jam_mulai, jam_selesai, jam_selesai, jam_mulai, jam_selesai]);
  
  // Check for teacher conflicts
  const teacherConflicts = await db.execute(`
    SELECT j.*, m.nama_mapel, k.nama_kelas
    FROM jadwal j
    JOIN mapel m ON j.mapel_id = m.id
    JOIN kelas k ON j.kelas_id = k.id
    WHERE j.guru_id = ? 
    AND j.hari = ?
    AND (
      (j.jam_mulai <= ? AND j.jam_selesai > ?) OR
      (j.jam_mulai < ? AND j.jam_selesai >= ?) OR
      (j.jam_mulai >= ? AND j.jam_selesai <= ?)
    )
  `, [guru_id, hari, jam_mulai, jam_mulai, jam_selesai, jam_selesai, jam_mulai, jam_selesai]);
  
    return {
    hasConflicts: classConflicts.length > 0 || teacherConflicts.length > 0,
    classConflicts,
    teacherConflicts
  };
};
```

### Schedule Generation Logic
```javascript
// Auto-generate weekly schedule
const generateWeeklySchedule = async (kelasId, semesterId) => {
  const days = ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
  const timeSlots = [
    { start: '07:00', end: '07:45' },
    { start: '07:45', end: '08:30' },
    { start: '08:30', end: '09:15' },
    { start: '09:15', end: '10:00' },
    { start: '10:00', end: '10:15' }, // Break
    { start: '10:15', end: '11:00' },
    { start: '11:00', end: '11:45' },
    { start: '11:45', end: '12:30' },
    { start: '12:30', end: '13:15' }, // Lunch
    { start: '13:15', end: '14:00' },
    { start: '14:00', end: '14:45' },
    { start: '14:45', end: '15:30' }
  ];
  
  const schedules = [];
  
  for (const day of days) {
    for (const slot of timeSlots) {
      if (slot.start === '10:00' || slot.start === '12:30') continue; // Skip breaks
      
      const schedule = {
        kelas_id,
        hari: day,
        jam_mulai: slot.start,
        jam_selesai: slot.end,
        semester_id: semesterId,
        status: 'active'
      };
      
      schedules.push(schedule);
    }
  }
  
  return schedules;
};
```

## 📊 Attendance Calculation Logic

### Attendance Statistics
```javascript
// Calculate attendance statistics
const calculateAttendanceStats = async (guruId, startDate, endDate) => {
  const [attendanceData] = await db.execute(`
    SELECT 
      COUNT(*) as total_sessions,
      SUM(CASE WHEN status = 'hadir' THEN 1 ELSE 0 END) as hadir_count,
      SUM(CASE WHEN status = 'tidak_hadir' THEN 1 ELSE 0 END) as tidak_hadir_count,
      SUM(CASE WHEN status = 'izin' THEN 1 ELSE 0 END) as izin_count,
      SUM(CASE WHEN status = 'sakit' THEN 1 ELSE 0 END) as sakit_count
    FROM absensi_guru
    WHERE guru_id = ? AND tanggal BETWEEN ? AND ?
  `, [guruId, startDate, endDate]);
  
  const stats = attendanceData[0];
  const attendanceRate = (stats.hadir_count / stats.total_sessions) * 100;
  
  return {
    totalSessions: stats.total_sessions,
    hadir: stats.hadir_count,
    tidakHadir: stats.tidak_hadir_count,
    izin: stats.izin_count,
    sakit: stats.sakit_count,
    attendanceRate: Math.round(attendanceRate * 100) / 100,
    status: getAttendanceStatus(attendanceRate)
  };
};

// Determine attendance status
const getAttendanceStatus = (attendanceRate) => {
  if (attendanceRate >= 95) return 'excellent';
  if (attendanceRate >= 90) return 'good';
  if (attendanceRate >= 80) return 'fair';
  if (attendanceRate >= 70) return 'poor';
  return 'critical';
};
```

### Late Arrival Detection
```javascript
// Detect late arrivals
const detectLateArrivals = async (guruId, date) => {
  const [schedules] = await db.execute(`
    SELECT j.*, ag.tanggal, ag.keterangan
    FROM jadwal j
    LEFT JOIN absensi_guru ag ON j.id = ag.jadwal_id AND ag.tanggal = ?
    WHERE j.guru_id = ? AND j.hari = DAYNAME(?)
  `, [date, guruId, date]);
  
  const lateArrivals = schedules.filter(schedule => {
    if (!schedule.tanggal) return false; // No attendance recorded
    
    const keterangan = schedule.keterangan || '';
    return keterangan.includes('terlambat') || keterangan.includes('late');
  });
  
  return lateArrivals;
};
```

## 📈 Report Generation Logic

### Attendance Report Generation
```javascript
// Generate comprehensive attendance report
const generateAttendanceReport = async (filters) => {
  const { startDate, endDate, kelasId, guruId, format = 'excel' } = filters;
  
  // Build query conditions
  let whereClause = 'WHERE ag.tanggal BETWEEN ? AND ?';
  const params = [startDate, endDate];
  
  if (kelasId) {
    whereClause += ' AND j.kelas_id = ?';
    params.push(kelasId);
  }
  
  if (guruId) {
    whereClause += ' AND ag.guru_id = ?';
    params.push(guruId);
  }
  
  // Get attendance data
  const [attendanceData] = await db.execute(`
    SELECT 
      ag.tanggal,
      j.hari,
      j.jam_mulai,
      j.jam_selesai,
      m.nama_mapel,
      k.nama_kelas,
      g.nama_guru,
      ag.status,
      ag.keterangan,
      CASE 
        WHEN ag.status = 'hadir' THEN 1
        ELSE 0
      END as hadir_score
    FROM absensi_guru ag
    JOIN jadwal j ON ag.jadwal_id = j.id
    JOIN mapel m ON j.mapel_id = m.id
    JOIN kelas k ON j.kelas_id = k.id
    JOIN guru g ON ag.guru_id = g.id
    ${whereClause}
    ORDER BY ag.tanggal, j.jam_mulai
  `, params);
  
  // Calculate summary statistics
  const summary = calculateReportSummary(attendanceData);
  
  // Generate report based on format
  if (format === 'excel') {
    return generateExcelReport(attendanceData, summary);
  } else if (format === 'pdf') {
    return generatePDFReport(attendanceData, summary);
  }
  
  return { data: attendanceData, summary };
};
```

### Report Summary Calculation
```javascript
// Calculate report summary statistics
const calculateReportSummary = (attendanceData) => {
  const totalSessions = attendanceData.length;
  const hadirCount = attendanceData.filter(record => record.status === 'hadir').length;
  const tidakHadirCount = attendanceData.filter(record => record.status === 'tidak_hadir').length;
  const izinCount = attendanceData.filter(record => record.status === 'izin').length;
  const sakitCount = attendanceData.filter(record => record.status === 'sakit').length;
  
  const attendanceRate = totalSessions > 0 ? (hadirCount / totalSessions) * 100 : 0;
  
  // Group by teacher
  const teacherStats = attendanceData.reduce((acc, record) => {
    const teacherName = record.nama_guru;
    if (!acc[teacherName]) {
      acc[teacherName] = {
        total: 0,
        hadir: 0,
        tidakHadir: 0,
        izin: 0,
        sakit: 0
      };
    }
    
    acc[teacherName].total++;
    acc[teacherName][record.status === 'hadir' ? 'hadir' : 
                     record.status === 'tidak_hadir' ? 'tidakHadir' :
                     record.status === 'izin' ? 'izin' : 'sakit']++;
    
    return acc;
  }, {});
  
  return {
    totalSessions,
    hadirCount,
    tidakHadirCount,
    izinCount,
    sakitCount,
    attendanceRate: Math.round(attendanceRate * 100) / 100,
    teacherStats
  };
};
```

