### NEW: Edit Absen (30 Hari) Business Logic
```javascript
// Edit Absen (30 Hari) validation dan business rules
const editAttendanceRules = {
  // 1. Date validation
  validateEditDate: (tanggal_absen) => {
    const today = new Date();
    const targetDate = new Date(tanggal_absen);
    const daysDiff = Math.floor((today - targetDate) / (1000 * 60 * 60 * 24));
    
    // Can only edit up to 30 days back
    if (daysDiff > 30) {
      throw new Error('Tidak dapat mengedit absensi lebih dari 30 hari ke belakang');
    }
    
    // Cannot edit future dates
    if (targetDate > today) {
      throw new Error('Tidak dapat mengedit absensi untuk tanggal masa depan');
    }
    
    return true;
  },
  
  // 2. Permission validation
  validateEditPermission: (userRole, guruId, scheduleGuruId) => {
    if (userRole !== 'guru') {
      throw new Error('Hanya guru yang dapat mengedit absensi');
    }
    
    if (guruId !== scheduleGuruId) {
      throw new Error('Guru hanya dapat mengedit absensi kelas yang diampu');
    }
    
    return true;
  },
  
  // 3. Audit trail
  createAuditLog: (oldData, newData, guruId) => {
    return {
      action: 'EDIT_ATTENDANCE',
      old_status: oldData.status,
      new_status: newData.status,
      guru_id: guruId,
      timestamp: new Date(),
      changes: {
        status: oldData.status !== newData.status,
        keterangan: oldData.keterangan !== newData.keterangan
      }
    };
  }
};
```

### NEW: Upsert Logic for Duplicate Prevention
```javascript
// Upsert logic untuk mencegah duplikasi data absensi
const upsertAttendanceLogic = {
  // 1. Check existing attendance
  checkExisting: async (siswaId, jadwalId, tanggal) => {
    const [existing] = await db.execute(
      'SELECT id, status, keterangan FROM absensi_siswa WHERE siswa_id = ? AND jadwal_id = ? AND tanggal = ?',
      [siswaId, jadwalId, tanggal]
    );
    
    return existing.length > 0 ? existing[0] : null;
  },
  
  // 2. Update existing record
  updateExisting: async (id, status, keterangan) => {
    await db.execute(
      'UPDATE absensi_siswa SET status = ?, keterangan = ?, waktu_absen = ? WHERE id = ?',
      [status, keterangan, new Date(), id]
    );
  },
  
  // 3. Insert new record
  insertNew: async (siswaId, jadwalId, tanggal, status, keterangan, guruId) => {
    await db.execute(
      'INSERT INTO absensi_siswa (siswa_id, jadwal_id, tanggal, status, keterangan, waktu_absen, guru_id) VALUES (?, ?, ?, ?, ?, ?, ?)',
      [siswaId, jadwalId, tanggal, status, keterangan, new Date(), guruId]
    );
  },
  
  // 4. Main upsert function
  upsert: async (attendanceData) => {
    const results = {
      updated: 0,
      inserted: 0,
      errors: []
    };
    
    for (const [studentId, status] of Object.entries(attendanceData.attendance)) {
      try {
        const existing = await upsertAttendanceLogic.checkExisting(
          studentId, 
          attendanceData.scheduleId, 
          attendanceData.tanggal_absen
        );
        
        if (existing) {
          await upsertAttendanceLogic.updateExisting(
            existing.id, 
            status, 
            attendanceData.notes[studentId]
          );
          results.updated++;
        } else {
          await upsertAttendanceLogic.insertNew(
            studentId, 
            attendanceData.scheduleId, 
            attendanceData.tanggal_absen, 
            status, 
            attendanceData.notes[studentId], 
            attendanceData.guruId
          );
          results.inserted++;
        }
      } catch (error) {
        results.errors.push({
          studentId,
          error: error.message
        });
      }
    }
    
    return results;
  }
};
```

