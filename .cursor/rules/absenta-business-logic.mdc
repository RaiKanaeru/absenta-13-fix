## 📊 Dashboard Business Logic

### Statistics Calculation
```javascript
const dashboardStats = {
  // 1. Real-time calculations
  realTime: {
    todayAttendance: async () => {
      const today = new Date().toISOString().split('T')[0];
      const [guru] = await db.execute(
        'SELECT COUNT(*) as count FROM absensi_guru WHERE tanggal = ? AND status = "Hadir"',
        [today]
      );
      const [siswa] = await db.execute(
        'SELECT COUNT(*) as count FROM absensi_siswa WHERE tanggal = ? AND status = "Hadir"',
        [today]
      );
      return { guru: guru[0].count, siswa: siswa[0].count };
    },
    
    attendanceRate: async (type) => {
      const total = await getTotalUsers(type);
      const present = await getPresentUsers(type);
      return total > 0 ? (present / total) * 100 : 0;
    }
  },
  
  // 2. Historical data
  historical: {
    weeklyTrend: async () => {
      // Calculate attendance trend for past 7 days
      const trends = [];
      for (let i = 6; i >= 0; i--) {
        const date = new Date();
        date.setDate(date.getDate() - i);
        const rate = await calculateDailyRate(date);
        trends.push({ date: date.toISOString().split('T')[0], rate });
      }
      return trends;
    }
  }
};
```

