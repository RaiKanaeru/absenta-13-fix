### Schedule Validation Logic
```javascript
async function validateSchedule(scheduleData) {
  const errors = [];
  
  // 1. Time validation
  if (scheduleData.jam_mulai >= scheduleData.jam_selesai) {
    errors.push('Jam mulai harus lebih awal dari jam selesai');
  }
  
  // 2. Duration validation
  const duration = calculateDuration(scheduleData.jam_mulai, scheduleData.jam_selesai);
  if (duration > 120) {
    errors.push('Durasi kelas maksimal 120 menit');
  }
  
  // 3. Conflict detection
  const conflicts = await checkScheduleConflicts(scheduleData);
  if (conflicts.length > 0) {
    errors.push(`Konflik jadwal: ${conflicts.join(', ')}`);
  }
  
  return errors;
}
```

