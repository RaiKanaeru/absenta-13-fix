### Import Execution Logic
```javascript
async function importScheduleData(filePath) {
  const results = {
    totalRows: 0,
    successful: 0,
    errors: [],
    warnings: []
  };
  
  try {
    // 1. Validate file
    const validation = await validateExcelFile(filePath);
    if (!validation.valid) {
      throw new Error(`File validation failed: ${validation.errors.join(', ')}`);
    }
    
    // 2. Parse Excel data
    const workbook = new ExcelJS.Workbook();
    await workbook.xlsx.readFile(filePath);
    
    // 3. Process each sheet
    for (const sheetName of ['Jadwal', 'Guru', 'Mapel', 'Kelas']) {
      const sheet = workbook.getWorksheet(sheetName);
      if (!sheet) {
        results.warnings.push(`Sheet '${sheetName}' not found`);
        continue;
      }
      
      // 4. Process rows
      const rows = sheet.getRows();
      results.totalRows += rows.length;
      
      for (const row of rows) {
        try {
          await processRowData(sheetName, row);
          results.successful++;
        } catch (error) {
          results.errors.push({
            sheet: sheetName,
            row: row.number,
            error: error.message
          });
        }
      }
    }
    
    return results;
  } catch (error) {
    throw new Error(`Import failed: ${error.message}`);
  }
}
```

## 🚨 Business Rule Violations

### Common Violations and Handling
```javascript
const businessRuleViolations = {
  // 1. Schedule conflicts
  scheduleConflict: {
    detection: async (newSchedule) => {
      const conflicts = await checkScheduleConflicts(newSchedule);
      return conflicts.length > 0;
    },
    handling: 'REJECT_WITH_MESSAGE',
    message: 'Jadwal bertabrakan dengan jadwal yang sudah ada'
  },
  
  // 2. Duplicate data
  duplicateData: {
    detection: async (table, field, value) => {
      const [existing] = await db.execute(
        `SELECT id FROM ${table} WHERE ${field} = ?`,
        [value]
      );
      return existing.length > 0;
    },
    handling: 'REJECT_WITH_MESSAGE',
    message: 'Data sudah ada dalam sistem'
  },
  
  // 3. Invalid references
  invalidReference: {
    detection: async (table, field, value) => {
      const [existing] = await db.execute(
        `SELECT id FROM ${table} WHERE id = ?`,
        [value]
      );
      return existing.length === 0;
    },
    handling: 'REJECT_WITH_MESSAGE',
    message: 'Referensi data tidak valid'
  }
};
```

