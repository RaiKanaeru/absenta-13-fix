### Migration Execution Logic
```javascript
async function migrateStudentData() {
  const migrationLog = [];
  
  try {
    // 1. Backup existing data
    await backupTable('siswa_perwakilan');
    
    // 2. Get source data
    const [sourceData] = await db.execute('SELECT * FROM siswa_perwakilan');
    
    // 3. Process each record
    for (const student of sourceData) {
      // Check for duplicates
      const [existing] = await db.execute(
        'SELECT id FROM pengguna WHERE nama_pengguna = ?',
        [student.username]
      );
      
      if (existing.length === 0) {
        // Migrate data
        const hashedPassword = await bcrypt.hash('password123', 10);
        await db.execute(
          `INSERT INTO pengguna (nama_pengguna, kata_sandi, peran, nama, email, status, dibuat_pada, diperbarui_pada)
           VALUES (?, ?, 'siswa', ?, ?, ?, ?, ?)`,
          [student.username, hashedPassword, student.nama, student.email, student.status, student.created_at, new Date()]
        );
        
        migrationLog.push({
          action: 'migrated',
          username: student.username,
          status: 'success'
        });
      } else {
        migrationLog.push({
          action: 'skipped',
          username: student.username,
          status: 'duplicate'
        });
      }
    }
    
    return migrationLog;
  } catch (error) {
    // Rollback on error
    await rollbackMigration();
    throw error;
  }
}
```

