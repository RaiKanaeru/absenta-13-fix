### Absence Alert System
```javascript
// Alert for consecutive absences
const checkConsecutiveAbsences = async () => {
  const [consecutiveAbsences] = await db.execute(`
    SELECT 
      ag.guru_id,
      g.nama_guru,
      g.email,
      COUNT(*) as consecutive_days
    FROM absensi_guru ag
    JOIN guru g ON ag.guru_id = g.id
    WHERE ag.status = 'tidak_hadir' 
    AND ag.tanggal >= DATE_SUB(CURDATE(), INTERVAL 3 DAY)
    GROUP BY ag.guru_id, g.nama_guru, g.email
    HAVING consecutive_days >= 3
  `);
  
  for (const absence of consecutiveAbsences) {
    await sendAbsenceAlert(absence);
  }
};

// Send absence alert
const sendAbsenceAlert = async (absenceData) => {
  const emailContent = {
    to: 'admin@school.com',
