      <p>Silakan lakukan tindakan yang diperlukan.</p>
    `
  };
  
  await transporter.sendMail(emailContent);
};
```

## 🔐 Security Business Rules

### Password Policy
```javascript
// Password validation rules
const validatePassword = (password) => {
  const rules = {
    minLength: 8,
    maxLength: 128,
    requireUppercase: true,
    requireLowercase: true,
    requireNumbers: true,
    requireSpecialChars: true,
    forbiddenPatterns: ['password', '123456', 'qwerty']
  };
  
  const errors = [];
  
  if (password.length < rules.minLength) {
    errors.push(`Password must be at least ${rules.minLength} characters long`);
  }
  
  if (password.length > rules.maxLength) {
    errors.push(`Password must be no more than ${rules.maxLength} characters long`);
  }
  
  if (rules.requireUppercase && !/[A-Z]/.test(password)) {
    errors.push('Password must contain at least one uppercase letter');
  }
  
  if (rules.requireLowercase && !/[a-z]/.test(password)) {
    errors.push('Password must contain at least one lowercase letter');
  }
  
  if (rules.requireNumbers && !/\d/.test(password)) {
    errors.push('Password must contain at least one number');
  }
  
  if (rules.requireSpecialChars && !/[!@#$%^&*(),.?":{}|<>]/.test(password)) {
    errors.push('Password must contain at least one special character');
  }
  
  for (const pattern of rules.forbiddenPatterns) {
    if (password.toLowerCase().includes(pattern)) {
      errors.push(`Password cannot contain common patterns like '${pattern}'`);
    }
  }
  
  return {
    isValid: errors.length === 0,
    errors
  };
};
```

### Account Lockout Policy
```javascript
// Account lockout after failed attempts
const handleFailedLogin = async (username) => {
  const maxAttempts = 5;
  const lockoutDuration = 30; // minutes
  
  // Get current attempt count
  const [attempts] = await db.execute(`
    SELECT failed_attempts, last_attempt, locked_until
    FROM pengguna 
    WHERE username = ?
  `, [username]);
  
  if (attempts.length === 0) return;
  
  const user = attempts[0];
  const now = new Date();
  
  // Check if account is still locked
  if (user.locked_until && new Date(user.locked_until) > now) {
    throw new Error('Account is temporarily locked due to too many failed attempts');
  }
  
  // Increment failed attempts
  const newAttemptCount = (user.failed_attempts || 0) + 1;
  
  if (newAttemptCount >= maxAttempts) {
    // Lock account
    const lockUntil = new Date(now.getTime() + lockoutDuration * 60000);
    await db.execute(`
      UPDATE pengguna 
      SET failed_attempts = ?, locked_until = ?
      WHERE username = ?
    `, [newAttemptCount, lockUntil, username]);
    
    throw new Error('Account locked due to too many failed attempts');
  } else {
    // Update attempt count
    await db.execute(`
      UPDATE pengguna 
      SET failed_attempts = ?, last_attempt = ?
      WHERE username = ?
    `, [newAttemptCount, now, username]);
  }
};
```

## 📊 Data Validation Rules

### Input Validation
```javascript
// Comprehensive input validation
const validateUserInput = (input, type) => {
  const validators = {
    username: {
      required: true,
      minLength: 3,
      maxLength: 50,
      pattern: /^[a-zA-Z0-9_]+$/,
      message: 'Username must be 3-50 characters, alphanumeric and underscore only'
    },
    email: {
      required: true,
      pattern: /^[^\s@]+@[^\s@]+\.[^\s@]+$/,
      message: 'Invalid email format'
    },
    phone: {
      required: false,
      pattern: /^(\+62|62|0)[0-9]{9,13}$/,
      message: 'Invalid Indonesian phone number format'
    },
    nis: {
      required: true,
      pattern: /^[0-9]{8,12}$/,
      message: 'NIS must be 8-12 digits'
    },
    nip: {
      required: true,
      pattern: /^[0-9]{18}$/,
      message: 'NIP must be exactly 18 digits'
    }
  };
  
  const validator = validators[type];
  if (!validator) return { isValid: true };
  
  const errors = [];
  
  if (validator.required && (!input || input.trim() === '')) {
    errors.push(`${type} is required`);
  }
  
  if (input && validator.minLength && input.length < validator.minLength) {
    errors.push(`${type} must be at least ${validator.minLength} characters`);
  }
  
  if (input && validator.maxLength && input.length > validator.maxLength) {
    errors.push(`${type} must be no more than ${validator.maxLength} characters`);
  }
  
  if (input && validator.pattern && !validator.pattern.test(input)) {
    errors.push(validator.message);
  }
  
  return {
    isValid: errors.length === 0,
    errors
  };
};
```

## 🔧 Business Logic Best Practices

### Error Handling
- **Graceful Degradation**: Handle errors without crashing
- **User-Friendly Messages**: Provide clear error messages
- **Logging**: Log errors for debugging
- **Recovery**: Implement retry mechanisms

### Data Consistency
- **Transactions**: Use database transactions for complex operations
- **Validation**: Validate data at multiple levels
- **Constraints**: Use database constraints
- **Audit Trail**: Track data changes

### Performance
- **Caching**: Cache frequently accessed data
- **Batch Operations**: Group related operations
- **Indexing**: Optimize database queries
- **Pagination**: Implement data pagination