## 🧪 Backend Testing Patterns

### API Endpoint Testing
```javascript
// API endpoint testing pattern
const testAPIEndpoint = async (endpoint, method, data, expectedStatus = 200) => {
  const response = await fetch(`http://localhost:3001${endpoint}`, {
    method,
    headers: {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${token}`
    },
    body: data ? JSON.stringify(data) : undefined
  });
  
  expect(response.status).toBe(expectedStatus);
  
  const result = await response.json();
  expect(result).toHaveProperty('success');
  
  return result;
};

// Usage
describe('Subject Management API', () => {
  it('should create new subject', async () => {
    const result = await testAPIEndpoint('/api/admin/mapel', 'POST', {
      kode_mapel: 'TEST',
      nama_mapel: 'Test Subject'
    });
    
    expect(result.success).toBe(true);
    expect(result.data).toHaveProperty('id_mapel');
  });
  
  it('should get all subjects', async () => {
    const result = await testAPIEndpoint('/api/admin/mapel', 'GET');
    
    expect(result.success).toBe(true);
    expect(Array.isArray(result.data)).toBe(true);
  });
});
```

### Database Testing
```javascript
// Database testing pattern
const testDatabaseOperation = async (query, params, expectedResult) => {
  const [rows] = await db.execute(query, params);
  
  if (expectedResult) {
    expect(rows).toEqual(expectedResult);
  }
  
  return rows;
};

// Usage
describe('Database Operations', () => {
  it('should insert user correctly', async () => {
    const result = await testDatabaseOperation(
      'INSERT INTO users (username, password, role, nama) VALUES (?, ?, ?, ?)',
      ['testuser', 'hashedpassword', 'guru', 'Test User']
    );
    
    expect(result.insertId).toBeGreaterThan(0);
  });
  
  it('should select users by role', async () => {
    const rows = await testDatabaseOperation(
      'SELECT * FROM users WHERE role = ?',
      ['guru']
    );
    
    expect(rows.length).toBeGreaterThan(0);
    expect(rows[0]).toHaveProperty('role', 'guru');
  });
});
```

### Authentication Testing
```javascript
// Authentication testing pattern
const testAuthentication = async (username, password, expectedRole) => {
  const response = await fetch('http://localhost:3001/api/login', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ username, password })
  });
  
  const result = await response.json();
  
  if (result.success) {
    expect(result.data).toHaveProperty('token');
    expect(result.data).toHaveProperty('role', expectedRole);
    return result.data.token;
  } else {
    throw new Error(`Authentication failed: ${result.message}`);
  }
};

// Usage
describe('Authentication', () => {
  it('should authenticate admin user', async () => {
    const token = await testAuthentication('admin', 'admin123', 'admin');
    expect(token).toBeDefined();
  });
  
  it('should authenticate guru user', async () => {
    const token = await testAuthentication('guru001', 'admin123', 'guru');
    expect(token).toBeDefined();
  });
  
  it('should reject invalid credentials', async () => {
    await expect(
      testAuthentication('invalid', 'password', 'admin')
    ).rejects.toThrow('Authentication failed');
  });
});
```

## 🎨 Frontend Testing Patterns

### Component Testing
```typescript
// React component testing with React Testing Library
import { render, screen, fireEvent, waitFor } from '@testing-library/react';
import { AttendanceComponent } from './AttendanceComponent';

describe('AttendanceComponent', () => {
  it('should render attendance form', () => {
    render(<AttendanceComponent />);
    
    expect(screen.getByText('Record Attendance')).toBeInTheDocument();
    expect(screen.getByRole('button', { name: 'Submit' })).toBeInTheDocument();
  });
  
  it('should handle form submission', async () => {
    const mockOnSubmit = jest.fn();
    render(<AttendanceComponent onSubmit={mockOnSubmit} />);
    
    fireEvent.click(screen.getByRole('button', { name: 'Submit' }));
    
    await waitFor(() => {
      expect(mockOnSubmit).toHaveBeenCalled();
    });
  });
});
```

### Hook Testing
```typescript
// Custom hook testing
import { renderHook, act } from '@testing-library/react';
import { useAttendance } from './useAttendance';

describe('useAttendance', () => {
  it('should initialize with empty data', () => {
    const { result } = renderHook(() => useAttendance());
    
    expect(result.current.data).toEqual([]);
    expect(result.current.loading).toBe(false);
  });
  
  it('should load attendance data', async () => {
    const { result } = renderHook(() => useAttendance());
    
    act(() => {
      result.current.loadData();
    });
    
    await waitFor(() => {
      expect(result.current.loading).toBe(false);
      expect(result.current.data).toBeDefined();
    });
  });
});
```

### Integration Testing
```typescript
// Frontend integration testing
describe('Attendance Flow Integration', () => {
  it('should complete attendance recording flow', async () => {
    render(<App />);
    
    // Login
    fireEvent.change(screen.getByLabelText('Username'), {
      target: { value: 'guru001' }
    });
    fireEvent.change(screen.getByLabelText('Password'), {
      target: { value: 'admin123' }
    });
    fireEvent.click(screen.getByRole('button', { name: 'Login' }));
    
    // Wait for dashboard
    await waitFor(() => {
      expect(screen.getByText('Teacher Dashboard')).toBeInTheDocument();
    });
    
    // Record attendance
    fireEvent.click(screen.getByText('Record Attendance'));
    fireEvent.click(screen.getByText('Hadir'));
    fireEvent.click(screen.getByRole('button', { name: 'Submit' }));
    
    // Verify success
    await waitFor(() => {
      expect(screen.getByText('Attendance recorded successfully')).toBeInTheDocument();
    });
  });
});
```

## 🔄 E2E Testing Patterns

### Playwright E2E Tests
```typescript
// E2E testing with Playwright
import { test, expect } from '@playwright/test';

test.describe('Attendance System E2E', () => {
  test('should complete teacher attendance flow', async ({ page }) => {
    // Navigate to login page
    await page.goto('http://localhost:3000');
    
    // Login as teacher
    await page.fill('[data-testid="username"]', 'guru001');
    await page.fill('[data-testid="password"]', 'admin123');
    await page.click('[data-testid="login-button"]');
    
    // Wait for dashboard
    await expect(page.locator('[data-testid="teacher-dashboard"]')).toBeVisible();
    
    // Navigate to attendance
    await page.click('[data-testid="attendance-menu"]');
    
    // Record attendance
    await page.click('[data-testid="record-attendance"]');
    await page.click('[data-testid="status-hadir"]');
    await page.click('[data-testid="submit-attendance"]');
    
    // Verify success
    await expect(page.locator('[data-testid="success-message"]')).toBeVisible();
  });
  
  test('should complete student permission flow', async ({ page }) => {
    // Navigate to login page
    await page.goto('http://localhost:3000');
    
    // Login as student
    await page.fill('[data-testid="username"]', 'perwakilan2000');
    await page.fill('[data-testid="password"]', 'admin123');
    await page.click('[data-testid="login-button"]');
    
    // Wait for dashboard
    await expect(page.locator('[data-testid="student-dashboard"]')).toBeVisible();
    
    // Navigate to permission
    await page.click('[data-testid="permission-menu"]');
    
    // Submit permission request
    await page.click('[data-testid="new-permission"]');
    await page.fill('[data-testid="reason"]', 'Sakit');
    await page.selectOption('[data-testid="permission-type"]', 'sakit');
    await page.click('[data-testid="submit-permission"]');
    
    // Verify success
    await expect(page.locator('[data-testid="success-message"]')).toBeVisible();
  });
});
```

