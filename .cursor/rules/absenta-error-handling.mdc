# Absenta Error Handling Patterns

## 🚨 Error Classification System

### Error Types and Severity Levels
```javascript
// Error classification
const ERROR_TYPES = {
  VALIDATION_ERROR: 'VALIDATION_ERROR',
  AUTHENTICATION_ERROR: 'AUTHENTICATION_ERROR',
  AUTHORIZATION_ERROR: 'AUTHORIZATION_ERROR',
  DATABASE_ERROR: 'DATABASE_ERROR',
  NETWORK_ERROR: 'NETWORK_ERROR',
  BUSINESS_LOGIC_ERROR: 'BUSINESS_LOGIC_ERROR',
  SYSTEM_ERROR: 'SYSTEM_ERROR'
};

const ERROR_SEVERITY = {
  LOW: 'LOW',
  MEDIUM: 'MEDIUM',
  HIGH: 'HIGH',
  CRITICAL: 'CRITICAL'
};

// Error severity mapping
const ERROR_SEVERITY_MAP = {
  [ERROR_TYPES.VALIDATION_ERROR]: ERROR_SEVERITY.LOW,
  [ERROR_TYPES.AUTHENTICATION_ERROR]: ERROR_SEVERITY.MEDIUM,
  [ERROR_TYPES.AUTHORIZATION_ERROR]: ERROR_SEVERITY.MEDIUM,
  [ERROR_TYPES.DATABASE_ERROR]: ERROR_SEVERITY.HIGH,
  [ERROR_TYPES.NETWORK_ERROR]: ERROR_SEVERITY.MEDIUM,
  [ERROR_TYPES.BUSINESS_LOGIC_ERROR]: ERROR_SEVERITY.MEDIUM,
  [ERROR_TYPES.SYSTEM_ERROR]: ERROR_SEVERITY.CRITICAL
};
```

## 🔧 Custom Error Classes

### Base Error Class
```javascript
// Base error class
class AbsentaError extends Error {
  constructor(message, type, severity, statusCode, details = null) {
    super(message);
    this.name = 'AbsentaError';
    this.type = type;
    this.severity = severity;
    this.statusCode = statusCode;
    this.details = details;
    this.timestamp = new Date().toISOString();
    this.stack = this.stack;
  }
  
  toJSON() {
    return {
      name: this.name,
      message: this.message,
      type: this.type,
      severity: this.severity,
      statusCode: this.statusCode,
      details: this.details,
      timestamp: this.timestamp
    };
  }
}

// Specific error classes
class ValidationError extends AbsentaError {
  constructor(message, details = null) {
    super(message, ERROR_TYPES.VALIDATION_ERROR, ERROR_SEVERITY.LOW, 400, details);
    this.name = 'ValidationError';
  }
}

class AuthenticationError extends AbsentaError {
  constructor(message, details = null) {
    super(message, ERROR_TYPES.AUTHENTICATION_ERROR, ERROR_SEVERITY.MEDIUM, 401, details);
    this.name = 'AuthenticationError';
  }
}

class AuthorizationError extends AbsentaError {
  constructor(message, details = null) {
    super(message, ERROR_TYPES.AUTHORIZATION_ERROR, ERROR_SEVERITY.MEDIUM, 403, details);
    this.name = 'AuthorizationError';
  }
}

class DatabaseError extends AbsentaError {
  constructor(message, details = null) {
    super(message, ERROR_TYPES.DATABASE_ERROR, ERROR_SEVERITY.HIGH, 500, details);
    this.name = 'DatabaseError';
  }
}

class BusinessLogicError extends AbsentaError {
  constructor(message, details = null) {
    super(message, ERROR_TYPES.BUSINESS_LOGIC_ERROR, ERROR_SEVERITY.MEDIUM, 422, details);
    this.name = 'BusinessLogicError';
  }
}
```

## 🛡️ Backend Error Handling

### Global Error Handler
```javascript
// Global error handler middleware
const globalErrorHandler = (error, req, res, next) => {
  // Log error
  console.error('Error occurred:', {
    message: error.message,
    stack: error.stack,
    url: req.url,
    method: req.method,
    ip: req.ip,
    userAgent: req.get('User-Agent'),
    timestamp: new Date().toISOString()
  });
  
  // Determine error response
  let statusCode = 500;
  let errorResponse = {
    success: false,
    error: 'Internal server error',
    message: 'Terjadi kesalahan pada server'
  };
  
  if (error instanceof AbsentaError) {
    statusCode = error.statusCode;
    errorResponse = {
      success: false,
      error: error.message,
      type: error.type,
      details: error.details
    };
  } else if (error.name === 'ValidationError') {
    statusCode = 400;
    errorResponse = {
      success: false,
      error: 'Validation failed',
      message: error.message,
      details: error.details
    };
  } else if (error.name === 'JsonWebTokenError') {
    statusCode = 401;
    errorResponse = {
      success: false,
      error: 'Invalid token',
      message: 'Token tidak valid'
    };
  } else if (error.name === 'TokenExpiredError') {
    statusCode = 401;
    errorResponse = {
      success: false,
      error: 'Token expired',
      message: 'Token telah kedaluwarsa'
    };
  }
  
  // Send error response
  res.status(statusCode).json(errorResponse);
};
```

### Database Error Handling
```javascript
// Database error handler
const handleDatabaseError = (error, operation) => {
  console.error(`Database error in ${operation}:`, error);
  
  if (error.code === 'ER_DUP_ENTRY') {
    throw new ValidationError('Data sudah ada', {
      field: error.sqlMessage.match(/for key '(.+)'/)?.[1],
      operation
    });
  }
  
  if (error.code === 'ER_NO_REFERENCED_ROW_2') {
    throw new ValidationError('Data referensi tidak ditemukan', {
      operation
    });
  }
  
  if (error.code === 'ER_ROW_IS_REFERENCED_2') {
    throw new BusinessLogicError('Data tidak dapat dihapus karena masih digunakan', {
      operation
    });
  }
  
  if (error.code === 'ER_CONNECTION_LOST') {
    throw new DatabaseError('Koneksi database terputus', {
      operation
    });
  }
  
  throw new DatabaseError('Database error occurred', {
    operation,
    code: error.code
  });
};

// Database operation wrapper
const safeDatabaseOperation = async (operation, ...args) => {
  try {
    return await operation(...args);
  } catch (error) {
    handleDatabaseError(error, operation.name);
  }
};
```

### API Error Handling
```javascript
// API error handling middleware
const apiErrorHandler = (req, res, next) => {
  // Handle async errors
  const asyncHandler = (fn) => {
    return (req, res, next) => {
      Promise.resolve(fn(req, res, next)).catch(next);
    };
  };
  
  // Handle specific API errors
  const handleAPIError = (error, req, res, next) => {
    if (error.type === 'entity.too.large') {
      return res.status(413).json({
        success: false,
        error: 'Payload too large',
        message: 'Ukuran data terlalu besar'
      });
    }
    
    if (error.code === 'LIMIT_FILE_SIZE') {
      return res.status(413).json({
        success: false,
        error: 'File too large',
        message: 'Ukuran file terlalu besar'
      });
    }
    
    next(error);
  };
  
  return { asyncHandler, handleAPIError };
};
```

## 🎨 Frontend Error Handling

### Error Boundary Component
```typescript
// Error boundary for React components
interface ErrorBoundaryState {
  hasError: boolean;
  error: Error | null;
  errorInfo: ErrorInfo | null;
}

class ErrorBoundary extends React.Component<PropsWithChildren<{}>, ErrorBoundaryState> {
  constructor(props: PropsWithChildren<{}>) {
    super(props);
    this.state = {
      hasError: false,
      error: null,
      errorInfo: null
    };
  }
  
  static getDerivedStateFromError(error: Error): ErrorBoundaryState {
    return {
      hasError: true,
      error,
      errorInfo: null
    };
  }
  
  componentDidCatch(error: Error, errorInfo: ErrorInfo) {
    console.error('Error caught by boundary:', error, errorInfo);
    
    // Log error to monitoring service
    this.logError(error, errorInfo);
    
    this.setState({
      error,
      errorInfo
    });
  }
  
  private logError = (error: Error, errorInfo: ErrorInfo) => {
    // Send error to monitoring service
    if (process.env.NODE_ENV === 'production') {
      // Send to Sentry or other monitoring service
      console.error('Error logged:', {
        message: error.message,
        stack: error.stack,
        componentStack: errorInfo.componentStack
      });
    }
  };
  
  render() {
    if (this.state.hasError) {
      return (
        <div className="flex items-center justify-center min-h-screen">
          <Card className="w-full max-w-md">
            <CardContent className="text-center p-6">
              <AlertCircle className="h-12 w-12 text-red-500 mx-auto mb-4" />
              <h2 className="text-xl font-semibold mb-2">Something went wrong</h2>
              <p className="text-gray-600 mb-4">
                We're sorry, but something unexpected happened.
              </p>
              <Button onClick={() => window.location.reload()}>
                Refresh Page
              </Button>
            </CardContent>
          </Card>
        </div>
      );
    }
    
    return this.props.children;
  }
}
```

### API Error Handling Hook
```typescript
// Custom hook for API error handling
const useAPIError = () => {
  const [error, setError] = useState<string | null>(null);
  const [isLoading, setIsLoading] = useState(false);
  
  const handleError = useCallback((error: any) => {
    console.error('API Error:', error);
    
    let errorMessage = 'An unexpected error occurred';
    
    if (error.response?.data?.error) {
      errorMessage = error.response.data.error;
    } else if (error.response?.data?.message) {
      errorMessage = error.response.data.message;
    } else if (error.message) {
      errorMessage = error.message;
    }
    
    setError(errorMessage);
  }, []);
  
  const clearError = useCallback(() => {
    setError(null);
  }, []);
  
  const executeWithErrorHandling = useCallback(async (operation: () => Promise<any>) => {
    setIsLoading(true);
    setError(null);
    
    try {
      const result = await operation();
      return result;
    } catch (err) {
      handleError(err);
      throw err;
    } finally {
      setIsLoading(false);
    }
  }, [handleError]);
  
  return {
    error,
    isLoading,
    handleError,
    clearError,
    executeWithErrorHandling
  };
};
```

### Form Error Handling
```typescript
// Form error handling component
interface FormErrorProps {
  error: string | null;
  field?: string;
}

const FormError: React.FC<FormErrorProps> = ({ error, field }) => {
  if (!error) return null;
  
  return (
    <div className="text-red-500 text-sm mt-1">
      {field ? `${field}: ${error}` : error}
    </div>
  );
};

// Form validation error handling
const useFormError = () => {
  const [errors, setErrors] = useState<Record<string, string>>({});
  
  const setError = useCallback((field: string, message: string) => {
    setErrors(prev => ({
      ...prev,
      [field]: message
    }));
  }, []);
  
  const clearError = useCallback((field: string) => {
    setErrors(prev => {
      const newErrors = { ...prev };
      delete newErrors[field];
      return newErrors;
    });
  }, []);
  
  const clearAllErrors = useCallback(() => {
    setErrors({});
  }, []);
  
  const hasError = useCallback((field: string) => {
    return !!errors[field];
  }, [errors]);
  
  return {
    errors,
    setError,
    clearError,
    clearAllErrors,
    hasError
  };
};
```

## 📊 Error Logging and Monitoring

### Error Logger
```javascript
// Comprehensive error logger
const errorLogger = {
  logError: (error, context = {}) => {
    const logEntry = {
      timestamp: new Date().toISOString(),
      level: 'ERROR',
      message: error.message,
      stack: error.stack,
      type: error.type || 'UNKNOWN',
      severity: error.severity || 'MEDIUM',
      context: {
        ...context,
        userAgent: context.userAgent || 'Unknown',
        ip: context.ip || 'Unknown',
        url: context.url || 'Unknown'
      }
    };
    
    // Console logging
    console.error('Error logged:', logEntry);
    
    // File logging
    fs.appendFileSync('logs/error.log', JSON.stringify(logEntry) + '\n');
    
    // Send to monitoring service in production
    if (process.env.NODE_ENV === 'production') {
      sendToMonitoringService(logEntry);
    }
  },
  
  logWarning: (message, context = {}) => {
    const logEntry = {
      timestamp: new Date().toISOString(),
      level: 'WARN',
      message,
      context
    };
    
    console.warn('Warning logged:', logEntry);
    fs.appendFileSync('logs/warning.log', JSON.stringify(logEntry) + '\n');
  },
  
  logInfo: (message, context = {}) => {
    const logEntry = {
      timestamp: new Date().toISOString(),
      level: 'INFO',
      message,
      context
    };
    
    console.log('Info logged:', logEntry);
    fs.appendFileSync('logs/info.log', JSON.stringify(logEntry) + '\n');
  }
};
```

### Error Monitoring Service
```javascript
// Error monitoring service integration
const sendToMonitoringService = async (logEntry) => {
  try {
    // Send to Sentry
    if (process.env.SENTRY_DSN) {
      Sentry.captureException(new Error(logEntry.message), {
        tags: {
          type: logEntry.type,
          severity: logEntry.severity
        },
        extra: logEntry.context
      });
    }
    
    // Send to custom monitoring service
    if (process.env.MONITORING_SERVICE_URL) {
      await fetch(process.env.MONITORING_SERVICE_URL, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${process.env.MONITORING_API_KEY}`
        },
        body: JSON.stringify(logEntry)
      });
    }
  } catch (error) {
    console.error('Failed to send error to monitoring service:', error);
  }
};
```

## 🔄 Error Recovery Patterns

### Retry Mechanism
```javascript
// Retry mechanism for failed operations
const retryOperation = async (operation, maxRetries = 3, delay = 1000) => {
  let lastError;
  
  for (let attempt = 1; attempt <= maxRetries; attempt++) {
    try {
      return await operation();
    } catch (error) {
      lastError = error;
      
      if (attempt === maxRetries) {
        throw lastError;
      }
      
      // Exponential backoff
      const waitTime = delay * Math.pow(2, attempt - 1);
      await new Promise(resolve => setTimeout(resolve, waitTime));
      
      console.log(`Retry attempt ${attempt} after ${waitTime}ms`);
    }
  }
  
  throw lastError;
};

// Database retry wrapper
const retryDatabaseOperation = async (operation, ...args) => {
  return retryOperation(async () => {
    return await operation(...args);
  }, 3, 1000);
};
```

### Circuit Breaker Pattern
```javascript
// Circuit breaker for external services
class CircuitBreaker {
  constructor(threshold = 5, timeout = 60000) {
    this.threshold = threshold;
    this.timeout = timeout;
    this.failureCount = 0;
    this.lastFailureTime = null;
    this.state = 'CLOSED'; // CLOSED, OPEN, HALF_OPEN
  }
  
  async execute(operation) {
    if (this.state === 'OPEN') {
      if (Date.now() - this.lastFailureTime > this.timeout) {
        this.state = 'HALF_OPEN';
      } else {
        throw new Error('Circuit breaker is OPEN');
      }
    }
    
    try {
      const result = await operation();
      this.onSuccess();
      return result;
    } catch (error) {
      this.onFailure();
      throw error;
    }
  }
  
  onSuccess() {
    this.failureCount = 0;
    this.state = 'CLOSED';
  }
  
  onFailure() {
    this.failureCount++;
    this.lastFailureTime = Date.now();
    
    if (this.failureCount >= this.threshold) {
      this.state = 'OPEN';
    }
  }
}
```

## 🎯 Error Handling Best Practices

### Backend Best Practices
- **Error Classification**: Categorize errors by type and severity
- **Custom Error Classes**: Create specific error classes for different scenarios
- **Global Error Handler**: Implement centralized error handling
- **Error Logging**: Log errors with context and stack traces
- **Error Monitoring**: Integrate with monitoring services
- **Graceful Degradation**: Handle errors without crashing the system

### Frontend Best Practices
- **Error Boundaries**: Catch and handle React errors
- **User-Friendly Messages**: Display clear error messages to users
- **Error Recovery**: Provide ways to recover from errors
- **Loading States**: Show loading states during operations
- **Validation**: Validate inputs before submission
- **Retry Mechanisms**: Allow users to retry failed operations

### General Best Practices
- **Error Prevention**: Validate inputs and handle edge cases
- **Error Documentation**: Document common errors and solutions
- **Error Testing**: Test error scenarios
- **Error Monitoring**: Monitor error rates and patterns
- **Error Recovery**: Implement recovery mechanisms
- **User Communication**: Communicate errors clearly to users