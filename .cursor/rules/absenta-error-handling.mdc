# Absenta Error Handling - Complete Guide

## 🚨 Error Handling Overview

**Absenta** menggunakan sistem error handling yang komprehensif untuk memastikan stabilitas dan keandalan sistem dengan graceful degradation dan user-friendly error messages.

## 🔧 Backend Error Handling

### Global Error Handler
```javascript
// Global error handler untuk Express.js
app.use((error, req, res, next) => {
  console.error('Global Error Handler:', error);
  
  // Log error dengan context
  logger.error('Unhandled Error', {
    error: error.message,
    stack: error.stack,
    url: req.url,
    method: req.method,
    ip: req.ip,
    userAgent: req.get('User-Agent'),
    timestamp: new Date().toISOString()
  });
  
  // Determine error type and response
  if (error.name === 'ValidationError') {
    return res.status(400).json({
      success: false,
      error: 'Data tidak valid',
      details: error.details,
      code: 'VALIDATION_ERROR'
    });
  }
  
  if (error.name === 'UnauthorizedError') {
    return res.status(401).json({
      success: false,
      error: 'Sesi Anda telah berakhir. Silakan login kembali.',
      code: 'UNAUTHORIZED'
    });
  }
  
  if (error.name === 'ForbiddenError') {
    return res.status(403).json({
      success: false,
      error: 'Anda tidak memiliki izin untuk mengakses resource ini.',
      code: 'FORBIDDEN'
    });
  }
  
  if (error.name === 'NotFoundError') {
    return res.status(404).json({
      success: false,
      error: 'Resource tidak ditemukan.',
      code: 'NOT_FOUND'
    });
  }
  
  // Database errors
  if (error.code === 'ER_DUP_ENTRY') {
    return res.status(409).json({
      success: false,
      error: 'Data sudah ada dalam sistem.',
      code: 'DUPLICATE_ENTRY'
    });
  }
  
  if (error.code === 'ER_NO_REFERENCED_ROW_2') {
    return res.status(400).json({
      success: false,
      error: 'Data referensi tidak ditemukan.',
      code: 'FOREIGN_KEY_CONSTRAINT'
    });
  }
  
  // Default server error
  return res.status(500).json({
    success: false,
    error: 'Terjadi kesalahan pada server. Silakan coba lagi.',
    code: 'INTERNAL_SERVER_ERROR',
    ...(process.env.NODE_ENV === 'development' && { details: error.message })
  });
});
```

### Custom Error Classes
```javascript
// Custom error classes untuk Absenta
class AbsentaError extends Error {
  constructor(message, code, statusCode = 500, details = null) {
    super(message);
    this.name = 'AbsentaError';
    this.code = code;
    this.statusCode = statusCode;
    this.details = details;
    this.timestamp = new Date().toISOString();
  }
}

class ValidationError extends AbsentaError {
  constructor(message, details = null) {
    super(message, 'VALIDATION_ERROR', 400, details);
    this.name = 'ValidationError';
  }
}

class AuthenticationError extends AbsentaError {
  constructor(message = 'Autentikasi gagal') {
    super(message, 'AUTHENTICATION_ERROR', 401);
    this.name = 'AuthenticationError';
  }
}

class AuthorizationError extends AbsentaError {
  constructor(message = 'Anda tidak memiliki izin untuk melakukan aksi ini') {
    super(message, 'AUTHORIZATION_ERROR', 403);
    this.name = 'AuthorizationError';
  }
}

class NotFoundError extends AbsentaError {
  constructor(resource = 'Resource') {
    super(`${resource} tidak ditemukan`, 'NOT_FOUND', 404);
    this.name = 'NotFoundError';
  }
}

class DatabaseError extends AbsentaError {
  constructor(message, originalError = null) {
    super(message, 'DATABASE_ERROR', 500, originalError);
    this.name = 'DatabaseError';
  }
}

class AttendanceError extends AbsentaError {
  constructor(message, details = null) {
    super(message, 'ATTENDANCE_ERROR', 400, details);
    this.name = 'AttendanceError';
  }
}

// Export error classes
module.exports = {
  AbsentaError,
  ValidationError,
  AuthenticationError,
  AuthorizationError,
  NotFoundError,
  DatabaseError,
  AttendanceError
};
```

### Database Error Handling
```javascript
// Database error handling utilities
const handleDatabaseError = (error, operation = 'database operation') => {
  console.error(`Database Error in ${operation}:`, error);
  
  // MySQL specific error handling
  switch (error.code) {
    case 'ER_DUP_ENTRY':
      throw new ValidationError('Data sudah ada dalam sistem', {
        field: error.sqlMessage.match(/for key '(.+)'/)?.[1],
        value: error.sqlMessage.match(/Duplicate entry '(.+)'/)?.[1]
      });
    
    case 'ER_NO_REFERENCED_ROW_2':
      throw new ValidationError('Data referensi tidak ditemukan', {
        constraint: error.sqlMessage.match(/FOREIGN KEY constraint fails/)?.[0]
      });
    
    case 'ER_ROW_IS_REFERENCED_2':
      throw new ValidationError('Data tidak dapat dihapus karena masih digunakan', {
        constraint: error.sqlMessage.match(/FOREIGN KEY constraint fails/)?.[0]
      });
    
    case 'ER_BAD_FIELD_ERROR':
      throw new DatabaseError('Field tidak ditemukan dalam tabel', error);
    
    case 'ER_TABLE_DOESNT_EXIST':
      throw new DatabaseError('Tabel tidak ditemukan', error);
    
    case 'ER_ACCESS_DENIED_ERROR':
      throw new DatabaseError('Akses database ditolak', error);
    
    case 'ER_CON_COUNT_ERROR':
      throw new DatabaseError('Terlalu banyak koneksi database', error);
    
    case 'ER_LOCK_WAIT_TIMEOUT':
      throw new DatabaseError('Timeout menunggu lock database', error);
    
    default:
      throw new DatabaseError(`Database error: ${error.message}`, error);
  }
};

// Safe database execution wrapper
const safeDbExecute = async (query, params = [], operation = 'database operation') => {
  try {
    const [result] = await db.execute(query, params);
    return result;
  } catch (error) {
    handleDatabaseError(error, operation);
  }
};
```

### API Error Handling
```javascript
// API error handling middleware
const apiErrorHandler = (req, res, next) => {
  // Wrap async functions to catch errors
  const wrapAsync = (fn) => {
    return (req, res, next) => {
      Promise.resolve(fn(req, res, next)).catch(next);
    };
  };
  
  return wrapAsync;
};

// Attendance API error handling
const handleAttendanceErrors = async (req, res, next) => {
  try {
    // Validate required fields
    const { scheduleId, attendance } = req.body;
    
    if (!scheduleId) {
      throw new ValidationError('Schedule ID diperlukan');
    }
    
    if (!attendance || Object.keys(attendance).length === 0) {
      throw new ValidationError('Data absensi diperlukan');
    }
    
    // Validate attendance data
    const validStatuses = ['Hadir', 'Izin', 'Sakit', 'Alpa', 'Dispen'];
    for (const [studentId, status] of Object.entries(attendance)) {
      if (!validStatuses.includes(status)) {
        throw new ValidationError(`Status tidak valid: ${status}`, {
          studentId,
          status,
          validStatuses
        });
      }
    }
    
    next();
  } catch (error) {
    next(error);
  }
};
