### Error Recovery Strategies
```javascript
// Error recovery strategies
const errorRecovery = {
  // Retry with exponential backoff
  retryWithBackoff: async (fn, maxRetries = 3, baseDelay = 1000) => {
    for (let attempt = 1; attempt <= maxRetries; attempt++) {
      try {
        return await fn();
      } catch (error) {
        if (attempt === maxRetries) {
          throw error;
        }
        
        const delay = baseDelay * Math.pow(2, attempt - 1);
        console.log(`Retry attempt ${attempt} after ${delay}ms`);
        await new Promise(resolve => setTimeout(resolve, delay));
      }
    }
  },
  
  // Fallback data
  withFallback: async (primaryFn, fallbackFn, fallbackData = null) => {
    try {
      return await primaryFn();
    } catch (error) {
      console.warn('Primary function failed, using fallback:', error.message);
      
      try {
        return await fallbackFn();
      } catch (fallbackError) {
        console.error('Fallback function also failed:', fallbackError.message);
        return fallbackData;
      }
    }
  },
  
  // Circuit breaker pattern
  circuitBreaker: (fn, threshold = 5, timeout = 60000) => {
    let failures = 0;
    let lastFailureTime = 0;
    let state = 'CLOSED'; // CLOSED, OPEN, HALF_OPEN
    
    return async (...args) => {
      if (state === 'OPEN') {
        if (Date.now() - lastFailureTime > timeout) {
          state = 'HALF_OPEN';
        } else {
          throw new Error('Circuit breaker is OPEN');
        }
      }
      
      try {
        const result = await fn(...args);
        failures = 0;
        state = 'CLOSED';
        return result;
      } catch (error) {
        failures++;
        lastFailureTime = Date.now();
        
        if (failures >= threshold) {
          state = 'OPEN';
        }
        
        throw error;
      }
    };
  }
};
```

## 🚨 Error Prevention

### Input Validation
```javascript
// Input validation utilities
const validators = {
  // Email validation
  email: (email) => {
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    return emailRegex.test(email);
  },
  
  // Phone number validation
  phone: (phone) => {
    const phoneRegex = /^(\+62|62|0)[0-9]{9,13}$/;
    return phoneRegex.test(phone);
  },
  
  // NIS validation
  nis: (nis) => {
    const nisRegex = /^[0-9]{4,10}$/;
    return nisRegex.test(nis);
  },
  
  // NIP validation
  nip: (nip) => {
    const nipRegex = /^[0-9]{18,19}$/;
    return nipRegex.test(nip);
  },
  
  // Date validation
  date: (date) => {
    const dateObj = new Date(date);
    return dateObj instanceof Date && !isNaN(dateObj.getTime());
  },
  
  // Required field validation
  required: (value) => {
    return value !== null && value !== undefined && value !== '';
  },
  
  // Length validation
  length: (value, min, max) => {
    return value.length >= min && value.length <= max;
  }
};

// Validation middleware
const validateInput = (schema) => {
  return (req, res, next) => {
    const errors = [];
    
    for (const [field, rules] of Object.entries(schema)) {
      const value = req.body[field];
      
      for (const rule of rules) {
        if (rule.required && !validators.required(value)) {
          errors.push(`${field} diperlukan`);
          continue;
        }
        
        if (value && rule.type && !validators[rule.type](value)) {
          errors.push(`${field} tidak valid`);
        }
        
        if (value && rule.minLength && !validators.length(value, rule.minLength, Infinity)) {
          errors.push(`${field} minimal ${rule.minLength} karakter`);
        }
        
        if (value && rule.maxLength && !validators.length(value, 0, rule.maxLength)) {
          errors.push(`${field} maksimal ${rule.maxLength} karakter`);
        }
      }
    }
    
    if (errors.length > 0) {
      return res.status(400).json({
        success: false,
        error: 'Data tidak valid',
        details: errors
      });
    }
    
    next();
  };
};
```

## 📈 Error Metrics & Alerting

### Error Metrics Collection
```javascript
// Error metrics collection
const errorMetrics = {
  counts: new Map(),
  rates: new Map(),
  
  // Track error occurrence
  trackError: (errorType, severity = 'medium') => {
    const key = `${errorType}:${severity}`;
    this.counts.set(key, (this.counts.get(key) || 0) + 1);
  },
  
  // Calculate error rates
  calculateRates: () => {
    const total = Array.from(this.counts.values()).reduce((sum, count) => sum + count, 0);
    
    for (const [key, count] of this.counts) {
      this.rates.set(key, count / total);
    }
  },
  
  // Get error summary
  getSummary: () => {
    this.calculateRates();
    
    return {
      totalErrors: Array.from(this.counts.values()).reduce((sum, count) => sum + count, 0),
      errorTypes: Object.fromEntries(this.counts),
      errorRates: Object.fromEntries(this.rates),
      timestamp: new Date().toISOString()
    };
  }
};

// Error alerting
const errorAlerts = {
  thresholds: {
    errorRate: 0.05, // 5% error rate
    criticalErrors: 10, // 10 critical errors per hour
    consecutiveErrors: 5 // 5 consecutive errors
  },
  
  checkAlerts: () => {
    const summary = errorMetrics.getSummary();
    
    // Check error rate
    if (summary.errorRates['critical:high'] > this.thresholds.errorRate) {
      this.sendAlert('HIGH_ERROR_RATE', summary);
    }
    
    // Check critical errors
    const criticalCount = summary.errorTypes['critical:high'] || 0;
    if (criticalCount > this.thresholds.criticalErrors) {
      this.sendAlert('HIGH_CRITICAL_ERRORS', summary);
    }
  },
  
  sendAlert: (type, data) => {
    console.error(`ALERT: ${type}`, data);
    
    // Send to monitoring service
    if (process.env.ALERT_WEBHOOK) {
      fetch(process.env.ALERT_WEBHOOK, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ type, data, timestamp: new Date().toISOString() })
      }).catch(console.error);
    }
  }
};
