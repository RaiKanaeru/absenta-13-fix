app.post('/api/attendance/teacher', authenticateToken, async (req, res) => {
  try {
    const { jadwalId, guruId, status, keterangan } = req.body;
    
    // Validate data
    const errors = attendanceErrorHandling.validateAttendanceData({
      jadwalId, status
    });
    
    if (errors.length > 0) {
      return res.status(400).json(errorResponses.validation(errors));
    }
    
    // Record attendance
    await teacherAttendanceLogic.recordTeacherAttendance({
      jadwalId,
      guruId,
      status,
      keterangan
    });
    
    res.success(null, 'Teacher attendance recorded successfully');
  } catch (error) {
    console.error('Error recording teacher attendance:', error);
    res.error('Failed to record teacher attendance', error.message);
  }
});

