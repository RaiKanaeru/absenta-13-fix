## 🔄 Attendance Business Logic

### Multi-Teacher Schedule Logic
```javascript
const multiTeacherLogic = {
  // 1. Assign multiple teachers to schedule
  assignTeachersToSchedule: async (jadwalId, teachers) => {
    try {
      await db.withTransaction(async (connection) => {
        // Remove existing assignments
        await connection.execute(
          'DELETE FROM jadwal_guru WHERE jadwal_id = ?',
          [jadwalId]
        );
        
        // Add new assignments
        for (const teacher of teachers) {
          await connection.execute(
            `INSERT INTO jadwal_guru (jadwal_id, guru_id, role, status) 
             VALUES (?, ?, ?, 'aktif')`,
            [jadwalId, teacher.guru_id, teacher.role || 'primary']
          );
        }
      });
      
      console.log(`✅ Assigned ${teachers.length} teachers to schedule ${jadwalId}`);
    } catch (error) {
      console.error('❌ Error assigning teachers:', error);
      throw error;
    }
  },
  
  // 2. Get teachers for a schedule
  getScheduleTeachers: async (jadwalId) => {
    const [teachers] = await db.execute(`
      SELECT 
        jg.*,
        g.nama as nama_guru,
        g.nip,
        g.email,
        u.nama_pengguna
      FROM jadwal_guru jg
      JOIN guru g ON jg.guru_id = g.id_guru
      JOIN pengguna u ON g.id_pengguna = u.id
      WHERE jg.jadwal_id = ? AND jg.status = 'aktif'
      ORDER BY jg.role, g.nama
    `, [jadwalId]);
    
    return teachers;
  },
  
  // 3. Check if teacher is assigned to schedule
  isTeacherAssigned: async (jadwalId, guruId) => {
    const [result] = await db.execute(
      'SELECT id FROM jadwal_guru WHERE jadwal_id = ? AND guru_id = ? AND status = "aktif"',
      [jadwalId, guruId]
    );
    
    return result.length > 0;
  }
};
```

### Teacher Attendance Recording
```javascript
const teacherAttendanceLogic = {
  // 1. Record teacher attendance by student
  recordTeacherAttendance: async (attendanceData) => {
    const {
      jadwalId,
      guruId,
      siswaId,
      status,
      keterangan,
      metodeAbsen = 'manual'
    } = attendanceData;
    
    try {
      // Validate teacher is assigned to schedule
      const isAssigned = await multiTeacherLogic.isTeacherAssigned(jadwalId, guruId);
      if (!isAssigned) {
        throw new Error('Guru tidak ditugaskan pada jadwal ini');
      }
      
      // Check if attendance already exists
      const [existing] = await db.execute(
        'SELECT id FROM absensi_guru WHERE jadwal_id = ? AND guru_id = ? AND tanggal = CURDATE()',
        [jadwalId, guruId]
      );
      
      if (existing.length > 0) {
        // Update existing attendance
        await db.execute(
          `UPDATE absensi_guru 
           SET status = ?, keterangan = ?, metode_absen = ?, waktu_catat = NOW()
           WHERE id = ?`,
          [status, keterangan, metodeAbsen, existing[0].id]
        );
      } else {
        // Create new attendance record
        await db.execute(
          `INSERT INTO absensi_guru 
           (jadwal_id, guru_id, kelas_id, siswa_pencatat_id, tanggal, jam_ke, status, keterangan, metode_absen)
           SELECT ?, ?, j.kelas_id, ?, CURDATE(), j.jam_ke, ?, ?, ?
           FROM jadwal j WHERE j.id_jadwal = ?`,
          [jadwalId, guruId, siswaId, status, keterangan, metodeAbsen, jadwalId]
        );
      }
      
      console.log(`✅ Teacher attendance recorded: ${guruId} - ${status}`);
      
      // Send notification to teacher
      await notificationService.sendTeacherAttendanceNotification(guruId, {
        status,
        keterangan,
        siswaId
      });
      
    } catch (error) {
      console.error('❌ Error recording teacher attendance:', error);
      throw error;
    }
  },
  
  // 2. Get teacher attendance for a class
  getTeacherAttendance: async (jadwalId, tanggal = null) => {
    const targetDate = tanggal || new Date().toISOString().split('T')[0];
    
    const [attendance] = await db.execute(`
      SELECT 
        ag.*,
        g.nama as nama_guru,
        g.nip,
        s.nama as nama_siswa_pencatat,
        j.hari,
        j.jam_ke,
        j.jam_mulai,
        j.jam_selesai
      FROM absensi_guru ag
      JOIN guru g ON ag.guru_id = g.id_guru
      JOIN siswa_perwakilan s ON ag.siswa_pencatat_id = s.id_siswa
      JOIN jadwal j ON ag.jadwal_id = j.id_jadwal
      WHERE ag.jadwal_id = ? AND ag.tanggal = ?
      ORDER BY ag.waktu_catat DESC
    `, [jadwalId, targetDate]);
    
    return attendance;
  }
};
```

