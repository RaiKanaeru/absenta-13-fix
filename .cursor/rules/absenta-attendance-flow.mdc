## 📱 Frontend Components

### Teacher Attendance Interface
```typescript
// TeacherAttendanceComponent.tsx
interface TeacherAttendanceProps {
  jadwalId: number;
  tanggal: string;
  onAttendanceRecorded: (data: any) => void;
}

const TeacherAttendanceComponent: React.FC<TeacherAttendanceProps> = ({
  jadwalId,
  tanggal,
  onAttendanceRecorded
}) => {
  const [students, setStudents] = useState([]);
  const [attendance, setAttendance] = useState({});
  const [loading, setLoading] = useState(false);

  // Load students for the class
  const loadStudents = async () => {
    try {
      const response = await api.get(`/api/attendance/students/${jadwalId}?tanggal=${tanggal}`);
      setStudents(response.data);
    } catch (error) {
      console.error('Error loading students:', error);
    }
  };

  // Record student attendance
  const recordAttendance = async (siswaId: number, status: string, keterangan?: string) => {
    try {
      setLoading(true);
      await api.post('/api/attendance/student', {
        jadwalId,
        siswaId,
        status,
        keterangan
      });
      
      setAttendance(prev => ({
        ...prev,
        [siswaId]: { status, keterangan }
      }));
      
      onAttendanceRecorded({ siswaId, status, keterangan });
    } catch (error) {
      console.error('Error recording attendance:', error);
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="teacher-attendance">
      <h3>Absensi Siswa</h3>
      <div className="students-list">
        {students.map(student => (
          <StudentAttendanceCard
            key={student.id}
            student={student}
            attendance={attendance[student.id]}
            onStatusChange={(status, keterangan) => 
              recordAttendance(student.id, status, keterangan)
            }
            loading={loading}
          />
        ))}
      </div>
    </div>
  );
};
```

