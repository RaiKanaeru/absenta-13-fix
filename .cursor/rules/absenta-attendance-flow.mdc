## 📊 Attendance Analytics

### Attendance Statistics
```javascript
const attendanceAnalytics = {
  // 1. Calculate attendance rates
  calculateAttendanceRates: async (jadwalId, startDate, endDate) => {
    const [stats] = await db.execute(`
      SELECT 
        COUNT(*) as total_sessions,
        SUM(CASE WHEN ag.status = 'Hadir' THEN 1 ELSE 0 END) as guru_hadir,
        SUM(CASE WHEN as.status = 'Hadir' THEN 1 ELSE 0 END) as siswa_hadir,
        (SUM(CASE WHEN ag.status = 'Hadir' THEN 1 ELSE 0 END) / COUNT(*)) * 100 as guru_attendance_rate,
        (SUM(CASE WHEN as.status = 'Hadir' THEN 1 ELSE 0 END) / COUNT(*)) * 100 as siswa_attendance_rate
      FROM jadwal j
      LEFT JOIN absensi_guru ag ON j.id_jadwal = ag.jadwal_id AND ag.tanggal BETWEEN ? AND ?
      LEFT JOIN absensi_siswa as ON j.id_jadwal = as.jadwal_id AND as.tanggal BETWEEN ? AND ?
      WHERE j.id_jadwal = ?
    `, [startDate, endDate, startDate, endDate, jadwalId]);
    
    return stats[0];
  },
  
  // 2. Get attendance trends
  getAttendanceTrends: async (jadwalId, days = 30) => {
    const [trends] = await db.execute(`
      SELECT 
        DATE(ag.tanggal) as tanggal,
        COUNT(*) as total_attendance,
        SUM(CASE WHEN ag.status = 'Hadir' THEN 1 ELSE 0 END) as guru_hadir,
        SUM(CASE WHEN as.status = 'Hadir' THEN 1 ELSE 0 END) as siswa_hadir
      FROM absensi_guru ag
      LEFT JOIN absensi_siswa as ON ag.jadwal_id = as.jadwal_id AND ag.tanggal = as.tanggal
      WHERE ag.jadwal_id = ? 
        AND ag.tanggal >= DATE_SUB(CURDATE(), INTERVAL ? DAY)
      GROUP BY DATE(ag.tanggal)
      ORDER BY tanggal DESC
    `, [jadwalId, days]);
    
    return trends;
  }
};
```

## 🚨 Error Handling for Attendance

### Attendance Error Handling
```javascript
const attendanceErrorHandling = {
  // 1. Validate attendance data
  validateAttendanceData: (data) => {
    const errors = [];
    
    if (!data.jadwalId) {
      errors.push('Jadwal ID is required');
    }
    
    if (!data.status) {
      errors.push('Status is required');
    }
    
    if (!['Hadir', 'Tidak Hadir', 'Sakit', 'Izin', 'Alpa', 'Dispen'].includes(data.status)) {
      errors.push('Invalid status');
    }
    
    return errors;
  },
  
  // 2. Handle attendance conflicts
  handleAttendanceConflict: async (jadwalId, userId, userType) => {
    try {
      // Check for existing attendance
      const table = userType === 'guru' ? 'absensi_guru' : 'absensi_siswa';
      const idField = userType === 'guru' ? 'guru_id' : 'siswa_id';
      
      const [existing] = await db.execute(
        `SELECT * FROM ${table} WHERE jadwal_id = ? AND ${idField} = ? AND tanggal = CURDATE()`,
        [jadwalId, userId]
      );
      
      if (existing.length > 0) {
        return {
          conflict: true,
          existing: existing[0],
          message: 'Attendance already recorded for today'
        };
      }
      
      return { conflict: false };
    } catch (error) {
      console.error('Error checking attendance conflict:', error);
      throw error;
    }
  }
};
```

