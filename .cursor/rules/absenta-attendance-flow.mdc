## 🔄 Real-time Synchronization

### WebSocket Implementation
```javascript
const attendanceWebSocket = {
  // 1. Initialize WebSocket connection
  initialize: (io) => {
    io.on('connection', (socket) => {
      console.log('User connected:', socket.id);
      
      // Join class room for real-time updates
      socket.on('join-class', (jadwalId) => {
        socket.join(`class-${jadwalId}`);
        console.log(`User joined class ${jadwalId}`);
      });
      
      // Handle attendance updates
      socket.on('attendance-update', (data) => {
        // Broadcast to all users in the class
        socket.to(`class-${data.jadwalId}`).emit('attendance-changed', data);
      });
      
      // Handle disconnect
      socket.on('disconnect', () => {
        console.log('User disconnected:', socket.id);
      });
    });
  },
  
  // 2. Broadcast attendance update
  broadcastUpdate: (io, jadwalId, updateData) => {
    io.to(`class-${jadwalId}`).emit('attendance-changed', updateData);
  }
};
```

### Real-time Attendance Updates
```javascript
const realTimeAttendance = {
  // 1. Update attendance in real-time
  updateAttendance: async (io, attendanceData) => {
    try {
      // Save to database
      await attendanceService.saveAttendance(attendanceData);
      
      // Broadcast update
      attendanceWebSocket.broadcastUpdate(io, attendanceData.jadwalId, {
        type: 'attendance_update',
        data: attendanceData,
        timestamp: new Date().toISOString()
      });
      
      console.log('✅ Attendance updated and broadcasted');
    } catch (error) {
      console.error('❌ Error updating attendance:', error);
      throw error;
    }
  },
  
  // 2. Get live attendance status
  getLiveAttendance: async (jadwalId) => {
    const [attendance] = await db.execute(`
      SELECT 
        ag.*,
        as.*,
        g.nama as nama_guru,
        s.nama as nama_siswa
      FROM absensi_guru ag
      LEFT JOIN absensi_siswa as ON ag.jadwal_id = as.jadwal_id AND ag.tanggal = as.tanggal
      JOIN guru g ON ag.guru_id = g.id_guru
      JOIN siswa_perwakilan s ON as.siswa_id = s.id_siswa
      WHERE ag.jadwal_id = ? AND ag.tanggal = CURDATE()
    `, [jadwalId]);
    
    return attendance;
  }
};
