### Query Optimization Patterns
```javascript
// Optimized query patterns
const optimizedQueries = {
  // 1. Student attendance history with proper joins
  getStudentAttendanceHistory: async (siswaId, startDate, endDate) => {
    const query = `
      SELECT 
        a.*,
        s.nama as nama_siswa,
        s.nis,
        k.nama_kelas,
        j.hari,
        j.jam_ke,
        j.jam_mulai,
        j.jam_selesai,
        m.nama_mapel,
        g.nama as nama_guru
      FROM absensi_siswa a
      INNER JOIN siswa s ON a.siswa_id = s.id_siswa
      INNER JOIN jadwal j ON a.jadwal_id = j.id_jadwal
      INNER JOIN mapel m ON j.mapel_id = m.id_mapel
      INNER JOIN guru g ON j.guru_id = g.id_guru
      INNER JOIN kelas k ON s.kelas_id = k.id_kelas
      WHERE a.siswa_id = ? 
        AND a.tanggal BETWEEN ? AND ?
      ORDER BY a.tanggal DESC, j.jam_ke ASC
      LIMIT 100
    `;
    
    return await db.execute(query, [siswaId, startDate, endDate]);
  },
  
  // 2. Teacher schedule with caching
  getTeacherSchedule: async (guruId, hari) => {
    const cacheKey = `schedule:guru:${guruId}:${hari}`;
    
    // Check cache first
    const cached = await redis.get(cacheKey);
    if (cached) {
      return JSON.parse(cached);
    }
    
    const query = `
      SELECT 
        j.*,
        m.nama_mapel,
        k.nama_kelas,
        k.ruang
      FROM jadwal j
      INNER JOIN mapel m ON j.mapel_id = m.id_mapel
      INNER JOIN kelas k ON j.kelas_id = k.id_kelas
      WHERE j.guru_id = ? 
        AND j.hari = ?
        AND j.status = 'aktif'
      ORDER BY j.jam_ke ASC
    `;
    
    const result = await db.execute(query, [guruId, hari]);
    
    // Cache for 1 hour
    await redis.setex(cacheKey, 3600, JSON.stringify(result));
    
    return result;
  },
  
  // 3. Paginated student list
  getStudentsPaginated: async (page = 1, limit = 20, search = '') => {
    const offset = (page - 1) * limit;
    
    let whereClause = 'WHERE s.status = "aktif"';
    let params = [];
    
    if (search) {
      whereClause += ' AND (s.nama LIKE ? OR s.nis LIKE ?)';
      params.push(`%${search}%`, `%${search}%`);
    }
    
    const query = `
      SELECT 
        s.*,
        k.nama_kelas,
        u.nama_pengguna,
        u.status as user_status
      FROM siswa s
      LEFT JOIN kelas k ON s.kelas_id = k.id_kelas
      LEFT JOIN pengguna u ON s.id_pengguna = u.id
      ${whereClause}
      ORDER BY s.nama ASC
      LIMIT ? OFFSET ?
    `;
    
    params.push(limit, offset);
    
    return await db.execute(query, params);
  }
};
```

## 💾 Caching Strategy

### Redis Caching Implementation
```javascript
// Redis caching utilities
const cacheManager = {
  // Cache configuration
  config: {
    defaultTTL: 3600, // 1 hour
    maxMemory: '256mb',
    evictionPolicy: 'allkeys-lru'
  },
  
  // Cache keys patterns
  keys: {
    schedule: 'cache:jadwal:',
    teacher: 'cache:guru:',
    student: 'cache:siswa:',
    attendance: 'cache:absensi:',
    report: 'cache:laporan:',
    user: 'cache:user:'
  },
  
  // Cache operations
  async get(key) {
      try {
        const value = await redis.get(key);
        return value ? JSON.parse(value) : null;
      } catch (error) {
      console.error('Cache get error:', error);
        return null;
      }
    },
    
  async set(key, value, ttl = this.config.defaultTTL) {
      try {
        await redis.setex(key, ttl, JSON.stringify(value));
      } catch (error) {
      console.error('Cache set error:', error);
      }
    },
    
  async del(key) {
      try {
        await redis.del(key);
      } catch (error) {
      console.error('Cache delete error:', error);
    }
  },
  
  // Cache invalidation patterns
  async invalidateUser(userId) {
    const patterns = [
      `${this.keys.user}${userId}`,
      `${this.keys.teacher}*`,
      `${this.keys.student}*`
    ];
    
    for (const pattern of patterns) {
        const keys = await redis.keys(pattern);
        if (keys.length > 0) {
          await redis.del(...keys);
      }
    }
  },
  
  async invalidateAttendance(scheduleId) {
    const patterns = [
      `${this.keys.attendance}*`,
      `${this.keys.schedule}${scheduleId}`
    ];
    
    for (const pattern of patterns) {
      const keys = await redis.keys(pattern);
      if (keys.length > 0) {
        await redis.del(...keys);
      }
    }
  }
};
```

### Frontend Caching
```typescript
// Frontend caching with React Query
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';

// Cache configuration
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      staleTime: 5 * 60 * 1000, // 5 minutes
      cacheTime: 10 * 60 * 1000, // 10 minutes
      retry: 3,
      retryDelay: attemptIndex => Math.min(1000 * 2 ** attemptIndex, 30000)
    }
  }
});

// Cached API hooks
export const useSchedules = (guruId: number, hari: string) => {
  return useQuery({
    queryKey: ['schedules', guruId, hari],
    queryFn: () => apiCall(`/api/guru/jadwal?guru_id=${guruId}&hari=${hari}`),
    staleTime: 5 * 60 * 1000, // 5 minutes
    enabled: !!guruId && !!hari
  });
};

export const useStudents = (jadwalId: number) => {
  return useQuery({
    queryKey: ['students', jadwalId],
    queryFn: () => apiCall(`/api/guru/daftar-siswa/${jadwalId}`),
    staleTime: 10 * 60 * 1000, // 10 minutes
    enabled: !!jadwalId
  });
};

// Cache invalidation on mutations
export const useSubmitAttendance = () => {
  const queryClient = useQueryClient();
  
  return useMutation({
    mutationFn: (data) => apiCall('/api/attendance/submit', {
      method: 'POST',
      body: JSON.stringify(data)
    }),
    onSuccess: () => {
      // Invalidate related caches
      queryClient.invalidateQueries(['schedules']);
      queryClient.invalidateQueries(['attendance']);
      queryClient.invalidateQueries(['students']);
    }
  });
};
```

## 🔄 Connection Pooling

### Database Connection Pool
```javascript
// Optimized database connection pool
const dbConfig = {
  host: process.env.DB_HOST || 'localhost',
  user: process.env.DB_USER || 'root',
  password: process.env.DB_PASSWORD || '',
  database: process.env.DB_NAME || 'absenta13',
  port: process.env.DB_PORT || 3306,
  
  // Connection pool settings
  connectionLimit: 20,
  acquireTimeout: 60000,
  timeout: 60000,
  reconnect: true,
  
  // Performance settings
  charset: 'utf8mb4',
  timezone: '+07:00',
  
  // Query optimization
  multipleStatements: false,
  dateStrings: false,
  debug: false,
  
  // Connection lifecycle
  idleTimeout: 300000, // 5 minutes
  maxIdle: 10,
  minIdle: 2
};

// Create connection pool
const pool = mysql.createPool(dbConfig);

// Connection pool monitoring
const monitorPool = () => {
  setInterval(() => {
    const stats = {
      totalConnections: pool._allConnections.length,
      freeConnections: pool._freeConnections.length,
      acquiringConnections: pool._acquiringConnections.length
    };
    
    console.log('Connection Pool Stats:', stats);
    
    // Alert if pool is getting full
    if (stats.freeConnections < 2) {
      console.warn('Connection pool is getting full!');
    }
  }, 30000); // Check every 30 seconds
};

monitorPool();
```

## 📈 Performance Monitoring

### Real-time Performance Metrics
```javascript
// Performance metrics collection
const performanceMetrics = {
  apiCalls: new Map(),
  dbQueries: new Map(),
  cacheHits: 0,
  cacheMisses: 0,
  
  // Track API performance
  trackApiCall: (endpoint, duration, status) => {
    const key = `${endpoint}:${status}`;
    if (!this.apiCalls.has(key)) {
      this.apiCalls.set(key, { count: 0, totalDuration: 0, avgDuration: 0 });
    }
    
    const stats = this.apiCalls.get(key);
    stats.count++;
    stats.totalDuration += duration;
    stats.avgDuration = stats.totalDuration / stats.count;
  },
  
  // Track database performance
  trackDbQuery: (query, duration) => {
    const key = query.substring(0, 50);
    if (!this.dbQueries.has(key)) {
      this.dbQueries.set(key, { count: 0, totalDuration: 0, avgDuration: 0 });
    }
    
    const stats = this.dbQueries.get(key);
    stats.count++;
    stats.totalDuration += duration;
    stats.avgDuration = stats.totalDuration / stats.count;
  },
  
  // Get performance report
  getReport: () => {
      return {
      apiCalls: Object.fromEntries(this.apiCalls),
      dbQueries: Object.fromEntries(this.dbQueries),
      cacheHitRate: this.cacheHits / (this.cacheHits + this.cacheMisses),
      timestamp: new Date().toISOString()
    };
  }
};
```

