## 🎨 Frontend Integration

### Display Jadwal Khusus di Jadwal Reguler

**Query Pattern**:
```javascript
// Get jadwal reguler + jadwal khusus untuk kelas tertentu
const getScheduleWithSpecial = async (kelasId, hari) => {
  // 1. Get jadwal reguler
  const regularSchedule = await fetch(
    `/api/siswa/jadwal?kelas_id=${kelasId}&hari=${hari}`
  );
  
  // 2. Get jadwal khusus
  const specialSchedule = await fetch(
    `/api/jadwal-khusus/kelas/${kelasId}?hari=${hari}`
  );
  
  // 3. Merge dan sort by jam_mulai
  const combined = [
    ...regularSchedule.data.map(s => ({ ...s, type: 'regular' })),
    ...specialSchedule.data.map(s => ({ ...s, type: 'special' }))
  ].sort((a, b) => a.jam_mulai.localeCompare(b.jam_mulai));
  
  return combined;
};
```

### Visual Differentiation (Colors)

Berikan warna berbeda untuk setiap jenis jadwal:

```typescript
const getScheduleColor = (type: string, jenisKegiatan?: string) => {
  if (type === 'regular') {
    return 'bg-blue-100 border-blue-300'; // Jadwal pelajaran: Biru
  }
  
  // Jadwal khusus
  switch (jenisKegiatan) {
    case 'istirahat':
      return 'bg-yellow-100 border-yellow-300'; // Istirahat: Kuning
    case 'upacara':
      return 'bg-red-100 border-red-300'; // Upacara: Merah
    case 'perwalian':
      return 'bg-purple-100 border-purple-300'; // Perwalian: Ungu
    default:
      return 'bg-gray-100 border-gray-300';
  }
};
```

### Example Component

```typescript
interface ScheduleCardProps {
  schedule: {
    type: 'regular' | 'special';
    jenis_kegiatan?: string;
    nama_kegiatan?: string;
    nama_mapel?: string;
    nama_guru?: string;
    jam_mulai: string;
    jam_selesai: string;
  };
}

const ScheduleCard: React.FC<ScheduleCardProps> = ({ schedule }) => {
  const colorClass = getScheduleColor(schedule.type, schedule.jenis_kegiatan);
  
  return (
    <div className={`p-3 rounded border-2 ${colorClass}`}>
      <div className="flex justify-between items-start">
        <div>
          <h4 className="font-semibold">
            {schedule.type === 'regular' 
              ? schedule.nama_mapel 
              : schedule.nama_kegiatan}
          </h4>
          {schedule.nama_guru && (
            <p className="text-sm text-gray-600">{schedule.nama_guru}</p>
          )}
        </div>
        <div className="text-right text-sm">
          <div>{schedule.jam_mulai.substring(0, 5)}</div>
          <div>{schedule.jam_selesai.substring(0, 5)}</div>
        </div>
      </div>
      
      {schedule.type === 'special' && (
        <div className="mt-2 text-xs">
          <span className="px-2 py-1 rounded bg-white bg-opacity-50">
            {schedule.jenis_kegiatan?.toUpperCase()}
          </span>
        </div>
      )}
    </div>
  );
};
```

