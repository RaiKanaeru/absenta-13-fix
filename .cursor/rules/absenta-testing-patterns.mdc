## 📊 Performance Testing Patterns

### Load Testing
```javascript
// tests/performance/load-tests/attendance-load.test.js
const { test, expect } = require('@playwright/test');

test.describe('Attendance System Load Test', () => {
  test('should handle concurrent attendance submissions', async ({ browser }) => {
    const contexts = [];
    const pages = [];
    
    // Create multiple browser contexts
    for (let i = 0; i < 10; i++) {
      const context = await browser.newContext();
      const page = await context.newPage();
      contexts.push(context);
      pages.push(page);
    }
    
    // Login all users concurrently
    const loginPromises = pages.map(async (page, index) => {
      await page.goto('http://localhost:8080');
      await page.fill('[data-testid="username-input"]', `guru${index.toString().padStart(3, '0')}`);
      await page.fill('[data-testid="password-input"]', 'admin123');
      await page.click('[data-testid="login-button"]');
      await page.waitForSelector('[data-testid="teacher-dashboard"]');
    });
    
    await Promise.all(loginPromises);
    
    // Submit attendance concurrently
    const attendancePromises = pages.map(async (page, index) => {
      await page.click('[data-testid="attendance-tab"]');
      await page.selectOption('[data-testid="schedule-select"]', '1');
      await page.selectOption('[data-testid="status-select"]', 'hadir');
      await page.fill('[data-testid="keterangan-input"]', `Concurrent test ${index}`);
      await page.click('[data-testid="submit-attendance"]');
      await page.waitForSelector('[data-testid="success-message"]');
    });
    
    const startTime = Date.now();
    await Promise.all(attendancePromises);
    const endTime = Date.now();
    
    console.log(`Concurrent attendance submissions completed in ${endTime - startTime}ms`);
    
    // Cleanup
    await Promise.all(contexts.map(context => context.close()));
  });
});
```

### Stress Testing
```javascript
// tests/performance/stress-tests/api-stress.test.js
const axios = require('axios');

describe('API Stress Test', () => {
  it('should handle high concurrent requests', async () => {
    const concurrentRequests = 100;
    const requests = [];
    
    for (let i = 0; i < concurrentRequests; i++) {
      requests.push(
        axios.get('http://localhost:3001/api/health')
          .then(response => ({ success: true, status: response.status }))
          .catch(error => ({ success: false, error: error.message }))
      );
    }
    
    const results = await Promise.all(requests);
    const successCount = results.filter(r => r.success).length;
    const failureCount = results.filter(r => !r.success).length;
    
    console.log(`Success: ${successCount}, Failures: ${failureCount}`);
    
    // Assert that at least 95% of requests succeed
    expect(successCount / concurrentRequests).toBeGreaterThan(0.95);
  });
});
```

## 🔧 Test Utilities & Helpers

### Test Data Factory
```javascript
// tests/fixtures/testDataFactory.js
const bcrypt = require('bcrypt');
const { db } = require('../db');

class TestDataFactory {
  static async createUser(userData = {}) {
    const defaultData = {
      username: `test_user_${Date.now()}`,
      password: 'test123',
      role: 'admin',
      status: 'active'
    };
    
    const data = { ...defaultData, ...userData };
    const hashedPassword = await bcrypt.hash(data.password, 10);
    
    const [result] = await db.execute(
      'INSERT INTO pengguna (username, password, role, status) VALUES (?, ?, ?, ?)',
      [data.username, hashedPassword, data.role, data.status]
    );
    
    return { id: result.insertId, ...data };
  }
  
  static async createTeacher(teacherData = {}) {
    const user = await this.createUser({ role: 'guru' });
    
    const defaultData = {
      user_id: user.id,
      nama_guru: `Test Teacher ${Date.now()}`,
      nip: `NIP${Date.now()}`,
      mapel_id: 1
    };
    
    const data = { ...defaultData, ...teacherData };
    
    const [result] = await db.execute(
      'INSERT INTO guru (user_id, nama_guru, nip, mapel_id) VALUES (?, ?, ?, ?)',
      [data.user_id, data.nama_guru, data.nip, data.mapel_id]
    );
    
    return { id: result.insertId, ...data, user };
  }
  
  static async createStudent(studentData = {}) {
    const user = await this.createUser({ role: 'siswa' });
    
    const defaultData = {
      user_id: user.id,
      nama_siswa: `Test Student ${Date.now()}`,
      nis: `NIS${Date.now()}`,
      kelas_id: 1
    };
    
    const data = { ...defaultData, ...studentData };
    
    const [result] = await db.execute(
      'INSERT INTO siswa_perwakilan (user_id, nama_siswa, nis, kelas_id) VALUES (?, ?, ?, ?)',
      [data.user_id, data.nama_siswa, data.nis, data.kelas_id]
    );
    
    return { id: result.insertId, ...data, user };
  }
  
  static async cleanup() {
    await db.execute('DELETE FROM absensi_guru WHERE guru_id IN (SELECT id FROM guru WHERE nama_guru LIKE "Test %")');
    await db.execute('DELETE FROM absensi_siswa WHERE siswa_id IN (SELECT id FROM siswa_perwakilan WHERE nama_siswa LIKE "Test %")');
    await db.execute('DELETE FROM guru WHERE nama_guru LIKE "Test %"');
    await db.execute('DELETE FROM siswa_perwakilan WHERE nama_siswa LIKE "Test %"');
    await db.execute('DELETE FROM pengguna WHERE username LIKE "test_%"');
  }
}

module.exports = TestDataFactory;
```

### Test Database Setup
```javascript
// tests/setup/testDatabase.js
const { db } = require('../db');

const setupTestDatabase = async () => {
  // Create test database if it doesn't exist
  await db.execute('CREATE DATABASE IF NOT EXISTS absenta_test');
  await db.execute('USE absenta_test');
  
  // Run migrations
  await runMigrations();
  
  // Seed test data
  await seedTestData();
};

const runMigrations = async () => {
  // Run database migrations for test environment
  const migrations = [
    'CREATE TABLE IF NOT EXISTS pengguna (id INT PRIMARY KEY AUTO_INCREMENT, username VARCHAR(255), password VARCHAR(255), role ENUM("admin", "guru", "siswa"), status ENUM("active", "inactive"))',
    // ... other table creation scripts
  ];
  
  for (const migration of migrations) {
    await db.execute(migration);
  }
};

const seedTestData = async () => {
  // Insert basic test data
  await db.execute(`
    INSERT IGNORE INTO pengguna (username, password, role, status) VALUES 
    ('admin123', '$2b$10$example', 'admin', 'active'),
    ('guru001', '$2b$10$example', 'guru', 'active'),
    ('siswa001', '$2b$10$example', 'siswa', 'active')
  `);
};

module.exports = { setupTestDatabase };
```

