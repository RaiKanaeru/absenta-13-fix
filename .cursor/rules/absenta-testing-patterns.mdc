# Absenta Testing Patterns & Best Practices

## 🧪 Testing Architecture

### Test Structure
```
tests/
├── unit/                    # Unit tests
│   ├── controllers/         # Controller tests
│   ├── services/           # Service layer tests
│   ├── repositories/       # Repository tests
│   └── utils/              # Utility function tests
├── integration/            # Integration tests
│   ├── api/               # API endpoint tests
│   ├── database/          # Database integration tests
│   └── auth/              # Authentication tests
├── e2e/                   # End-to-end tests
│   ├── user-flows/        # User journey tests
│   └── admin-flows/       # Admin workflow tests
├── performance/           # Performance tests
│   ├── load-tests/        # Load testing
│   └── stress-tests/      # Stress testing
└── fixtures/              # Test data fixtures
    ├── users.json
    ├── schedules.json
    └── attendance.json
```

## 🔧 Unit Testing Patterns

### Controller Testing
```javascript
// tests/unit/controllers/authController.test.js
const request = require('supertest');
const app = require('../../app');
const { db } = require('../../db');

describe('AuthController', () => {
  beforeEach(async () => {
    // Setup test data
    await db.execute('DELETE FROM pengguna WHERE username LIKE "test_%"');
  });

  afterEach(async () => {
    // Cleanup test data
    await db.execute('DELETE FROM pengguna WHERE username LIKE "test_%"');
  });

  describe('POST /api/login', () => {
    it('should login with valid credentials', async () => {
      // Arrange
      const userData = {
        username: 'test_admin',
        password: 'test123',
        role: 'admin',
        status: 'active'
      };
      
      // Create test user
      const hashedPassword = await bcrypt.hash(userData.password, 10);
      await db.execute(
        'INSERT INTO pengguna (username, password, role, status) VALUES (?, ?, ?, ?)',
        [userData.username, hashedPassword, userData.role, userData.status]
      );

      // Act
      const response = await request(app)
        .post('/api/login')
        .send({
          username: userData.username,
          password: userData.password
        });

      // Assert
      expect(response.status).toBe(200);
      expect(response.body.success).toBe(true);
      expect(response.body.token).toBeDefined();
      expect(response.body.user.username).toBe(userData.username);
    });

    it('should reject invalid credentials', async () => {
      // Act
      const response = await request(app)
        .post('/api/login')
        .send({
          username: 'invalid_user',
          password: 'wrong_password'
        });

      // Assert
      expect(response.status).toBe(401);
      expect(response.body.success).toBe(false);
      expect(response.body.error).toBe('Invalid username or password');
    });

    it('should validate required fields', async () => {
      // Act
      const response = await request(app)
        .post('/api/login')
        .send({
          username: 'test_user'
          // Missing password
        });

      // Assert
      expect(response.status).toBe(400);
      expect(response.body.error).toBe('Validation failed');
    });
  });
});
```

### Service Layer Testing
```javascript
// tests/unit/services/authService.test.js
const AuthService = require('../../services/authService');
const { db } = require('../../db');

describe('AuthService', () => {
  describe('authenticateUser', () => {
    it('should authenticate valid user', async () => {
      // Arrange
      const username = 'test_user';
      const password = 'test123';
      const hashedPassword = await bcrypt.hash(password, 10);
      
      await db.execute(
        'INSERT INTO pengguna (username, password, role, status) VALUES (?, ?, ?, ?)',
        [username, hashedPassword, 'admin', 'active']
      );

      // Act
      const result = await AuthService.authenticateUser(username, password);

      // Assert
      expect(result.success).toBe(true);
      expect(result.user.username).toBe(username);
      expect(result.token).toBeDefined();
    });

    it('should reject invalid password', async () => {
      // Arrange
      const username = 'test_user';
      const password = 'test123';
      const wrongPassword = 'wrong123';
      const hashedPassword = await bcrypt.hash(password, 10);
      
      await db.execute(
        'INSERT INTO pengguna (username, password, role, status) VALUES (?, ?, ?, ?)',
        [username, hashedPassword, 'admin', 'active']
      );

      // Act
      const result = await AuthService.authenticateUser(username, wrongPassword);

      // Assert
      expect(result.success).toBe(false);
      expect(result.error).toBe('Invalid credentials');
    });
  });
});
```

### Repository Testing
```javascript
// tests/unit/repositories/userRepository.test.js
const UserRepository = require('../../repositories/userRepository');
const { db } = require('../../db');

describe('UserRepository', () => {
  let userRepository;

  beforeEach(() => {
    userRepository = new UserRepository();
  });

  describe('findByUsername', () => {
    it('should find user by username', async () => {
      // Arrange
      const userData = {
        username: 'test_user',
        password: 'hashed_password',
        role: 'admin',
        status: 'active'
      };
      
      await db.execute(
        'INSERT INTO pengguna (username, password, role, status) VALUES (?, ?, ?, ?)',
        [userData.username, userData.password, userData.role, userData.status]
      );

      // Act
      const user = await userRepository.findByUsername(userData.username);

      // Assert
      expect(user).toBeDefined();
      expect(user.username).toBe(userData.username);
      expect(user.role).toBe(userData.role);
    });

    it('should return null for non-existent user', async () => {
      // Act
      const user = await userRepository.findByUsername('non_existent_user');

      // Assert
      expect(user).toBeNull();
    });
  });
});
```

## 🔗 Integration Testing Patterns

### API Integration Tests
```javascript
// tests/integration/api/attendance.test.js
const request = require('supertest');
const app = require('../../app');
const { db } = require('../../db');

describe('Attendance API Integration', () => {
  let authToken;
  let testUser;

  beforeAll(async () => {
    // Setup test user and get auth token
    testUser = await createTestUser();
    authToken = await getAuthToken(testUser);
  });

  afterAll(async () => {
    // Cleanup test data
    await cleanupTestData();
  });

  describe('POST /api/attendance/submit', () => {
    it('should submit teacher attendance', async () => {
      // Arrange
      const attendanceData = {
        jadwal_id: 1,
        guru_id: testUser.id,
        tanggal: '2025-01-13',
        status: 'hadir',
        keterangan: 'Hadir tepat waktu'
      };

      // Act
      const response = await request(app)
        .post('/api/attendance/submit')
        .set('Authorization', `Bearer ${authToken}`)
        .send(attendanceData);

      // Assert
      expect(response.status).toBe(200);
      expect(response.body.success).toBe(true);
      
      // Verify data was saved
      const [rows] = await db.execute(
        'SELECT * FROM absensi_guru WHERE guru_id = ? AND tanggal = ?',
        [testUser.id, attendanceData.tanggal]
      );
      expect(rows.length).toBe(1);
      expect(rows[0].status).toBe(attendanceData.status);
    });
  });
});
```

### Database Integration Tests
```javascript
// tests/integration/database/attendance.test.js
const { db } = require('../../db');

describe('Attendance Database Integration', () => {
  beforeEach(async () => {
    // Setup test data
    await setupTestData();
  });

  afterEach(async () => {
    // Cleanup test data
    await cleanupTestData();
  });

  it('should handle attendance transaction correctly', async () => {
    const connection = await db.getConnection();
    
    try {
      await connection.beginTransaction();
      
      // Insert attendance record
      const [result] = await connection.execute(
        'INSERT INTO absensi_guru (jadwal_id, guru_id, tanggal, status) VALUES (?, ?, ?, ?)',
        [1, 1, '2025-01-13', 'hadir']
      );
      
      const attendanceId = result.insertId;
      
      // Verify record was inserted
      const [rows] = await connection.execute(
        'SELECT * FROM absensi_guru WHERE id = ?',
        [attendanceId]
      );
      
      expect(rows.length).toBe(1);
      expect(rows[0].status).toBe('hadir');
      
      await connection.commit();
    } catch (error) {
      await connection.rollback();
      throw error;
    } finally {
      connection.release();
    }
  });
});
```

## 🎭 End-to-End Testing Patterns

### User Journey Tests
```javascript
// tests/e2e/user-flows/teacher-attendance.test.js
const { test, expect } = require('@playwright/test');

test.describe('Teacher Attendance Flow', () => {
  test('should complete teacher attendance workflow', async ({ page }) => {
    // Login as teacher
    await page.goto('http://localhost:8080');
    await page.fill('[data-testid="username-input"]', 'guru001');
    await page.fill('[data-testid="password-input"]', 'admin123');
    await page.click('[data-testid="login-button"]');
    
    // Wait for dashboard to load
    await page.waitForSelector('[data-testid="teacher-dashboard"]');
    
    // Navigate to attendance page
    await page.click('[data-testid="attendance-tab"]');
    
    // Fill attendance form
    await page.selectOption('[data-testid="schedule-select"]', '1');
    await page.selectOption('[data-testid="status-select"]', 'hadir');
    await page.fill('[data-testid="keterangan-input"]', 'Hadir tepat waktu');
    
    // Submit attendance
    await page.click('[data-testid="submit-attendance"]');
    
    // Verify success message
    await expect(page.locator('[data-testid="success-message"]')).toBeVisible();
    await expect(page.locator('[data-testid="success-message"]')).toContainText('Kehadiran berhasil disimpan');
  });
});
```

