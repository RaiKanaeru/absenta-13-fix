# ================================================
# ABSENTA MODERN SERVER CONFIGURATION
# ================================================

# Server Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=absenta13
DB_CONNECTION_LIMIT=10

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
PASSWORD_PEPPER=your-password-pepper-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_EXPIRES_IN_MS=86400000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:5173,http://localhost:3000,http://localhost:3001

# Logging Configuration
LOG_LEVEL=info
LOG_DIR=logs
LOG_MAX_SIZE=5242880
LOG_MAX_FILES=5

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# File Upload Configuration
MAX_FILE_SIZE=10mb
MAX_PAYLOAD_SIZE=10mb

# Request Configuration
REQUEST_TIMEOUT=30000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
