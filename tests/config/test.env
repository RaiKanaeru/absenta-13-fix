# Test Environment Configuration
NODE_ENV=test
PORT=3001

# Database Configuration for Testing
DB_HOST_TEST=localhost
DB_USER_TEST=root
DB_PASSWORD_TEST=
DB_NAME_TEST=absenta_test
DB_PORT_TEST=3306

# JWT Configuration for Testing
JWT_SECRET=test-jwt-secret-key-for-testing-only
JWT_EXPIRES_IN=24h

# Password Configuration for Testing
PASSWORD_PEPPER=test-pepper-for-testing-only
BCRYPT_ROUNDS=10

# Rate Limiting for Testing
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration for Testing
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel

# Logging Configuration for Testing
LOG_LEVEL=error
LOG_FILE=logs/test.log

# Cache Configuration for Testing
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# Email Configuration for Testing (Mock)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=test@example.com
SMTP_PASS=testpassword
SMTP_FROM=test@example.com

# Security Configuration for Testing
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true
HELMET_ENABLED=true
CSRF_ENABLED=true

# Performance Testing Configuration
ARTILLERY_TARGET=http://localhost:3001
ARTILLERY_PHASES=60,120,60
ARTILLERY_ARRIVAL_RATE=5,10,20

# Test Data Configuration
TEST_DATA_SEED=true
TEST_DATA_CLEANUP=true
TEST_DATA_ISOLATION=true

# Coverage Configuration
COVERAGE_THRESHOLD=80
COVERAGE_REPORTERS=text,lcov,html,json
COVERAGE_DIRECTORY=coverage

# Playwright Configuration
PLAYWRIGHT_BROWSERS=chromium,firefox,webkit
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# Jest Configuration
JEST_TIMEOUT=30000
JEST_VERBOSE=true
JEST_DETECT_OPEN_HANDLES=true
JEST_FORCE_EXIT=true

# Test Isolation
TEST_ISOLATION=true
TEST_PARALLEL=false
TEST_RETRY=3
TEST_TIMEOUT=30000
